<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mahindra Engineering Records</title>
    <link
      rel="stylesheet"
      href="https://fontsstorage.blob.core.windows.net/html/css/georama.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <style>
      :root {
        --red: #a9153d;
        --red-soft: #f7e9ee;
        --navy: #071b2d;
        --ink: #243746;
        --muted: #71818d;
        --bg: #f3f6f8;
        --surface: #fff;
        --border: #dce4e9;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Georama-Regular", Arial, sans-serif;
        font-size: 12px;
      }
      .topbar {
        height: 68px;
        background: #fff;
        border-bottom: 2px solid #a9153d;
        box-shadow: 0 1px 5px rgba(7, 27, 45, 0.06);
      }
      .header-inner {
        height: 68px;
      }
      .mahindra-logo img {
        width: 170px;
        height: auto;
      }
      .top-menu {
        display: flex;
        gap: 4px;
        align-items: center;
      }
      .top-menu a {
        color: #465967;
        text-decoration: none;
        padding: 11px 16px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
      }
      .top-menu a:hover,
      .top-menu a.active {
        background: #f5eaf0;
        color: var(--red);
      }
      .top-menu a.active {
        box-shadow: inset 0 -2px 0 var(--red);
      }
      .profile-btn {
        border: 0;
        background: transparent;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 5px 7px;
      }
      .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #a9153d;
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 11px;
      }
      .profile-name {
        font-size: 11px;
        font-weight: 800;
        text-align: left;
      }
      .profile-role {
        font-size: 9px;
        color: #7b8993;
      }
      .dropdown-menu {
        border: 1px solid var(--border);
        box-shadow: 0 8px 24px #071b2d22;
        border-radius: 8px;
      }
      .dropdown-item {
        font-size: 12px;
        padding: 9px 14px;
      }

      .page {
        padding: 24px 28px 40px;
        max-width: 1500px;
        margin: auto;
      }
      .breadcrumb {
        font-size: 10px;
        color: #82909a;
        margin-bottom: 7px;
      }
      .breadcrumb strong {
        color: #4e6270;
      }
      .page-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
      }
      .page-title {
        font-size: 23px;
        font-weight: 800;
        color: var(--navy);
        margin: 0;
      }
      .page-subtitle {
        font-size: 11px;
        color: #71818d;
        margin-top: 5px;
      }
      .title-accent {
        height: 3px;
        width: 45px;
        background: var(--red);
        border-radius: 3px;
        margin-top: 9px;
      }
      .header-actions {
        display: flex;
        gap: 8px;
      }
      .btn-light-action {
        height: 36px;
        border: 1px solid #d5dfe5;
        background: #fff;
        color: #526672;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        padding: 0 13px;
      }
      .btn-primary-mahindra {
        height: 36px;
        background: var(--red);
        border: 1px solid var(--red);
        color: #fff;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 800;
        padding: 0 15px;
      }
      .btn-primary-mahindra:hover {
        background: #8f1234;
        color: #fff;
      }

      .tabs {
        display: flex;
        gap: 24px;
        border-bottom: 1px solid #d9e1e6;
        margin-bottom: 15px;
      }
      .tabs a {
        padding: 9px 2px 10px;
        color: #617481;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        position: relative;
      }
      .tabs a.active {
        color: var(--red);
      }
      .tabs a.active:after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: var(--red);
      }

      .filter-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 9px #071b2d0c;
        padding: 15px 17px 16px;
        margin-bottom: 14px;
      }
      .filter-grid {
        display: grid;
        grid-template-columns: 1.35fr 1fr 1fr 1.25fr 1fr auto;
        gap: 11px;
        align-items: end;
      }
      .filter-label {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 800;
        color: #687a87;
        margin-bottom: 5px;
      }
      .filter-control {
        height: 37px;
        border: 1px solid #d5dfe6;
        border-radius: 6px;
        font-size: 11px;
        color: #415563;
        background: #fff;
      }
      .filter-control:focus {
        border-color: #bb7088;
        box-shadow: 0 0 0 3px rgba(169, 21, 61, 0.07);
      }
      .filter-actions {
        display: flex;
        gap: 7px;
      }
      .apply {
        height: 37px;
        background: var(--red);
        color: #fff;
        border: 1px solid var(--red);
        font-size: 10px;
        font-weight: 800;
        padding: 0 16px;
        border-radius: 6px;
      }
      .clear {
        height: 37px;
        border: 1px solid #d5dfe6;
        background: #fff;
        color: #657682;
        border-radius: 6px;
        width: 38px;
      }

      .table-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 9px #071b2d0c;
        overflow: hidden;
      }
      .table-head {
        padding: 15px 17px 11px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .table-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--navy);
      }
      .table-meta {
        font-size: 10px;
        color: #7a8994;
        margin-top: 3px;
      }
      .table-tools {
        display: flex;
        gap: 7px;
      }
      .tool-btn {
        height: 32px;
        border: 1px solid #d7e0e5;
        background: #fff;
        border-radius: 6px;
        color: #617481;
        font-size: 10px;
        padding: 0 11px;
        font-weight: 700;
      }
      .table-wrap {
        overflow: auto;
        border-top: 1px solid #e2e8ec;
      }
      .records-table {
        width: 100%;
        min-width: 1550px;
        border-collapse: separate;
        border-spacing: 0;
      }
      .records-table th {
        background: #f5f7f9;
        color: #627582;
        border-right: 1px solid #edf1f4;
        border-bottom: 1px solid #dce4e9;
        padding: 10px 9px;
        font-size: 8px;
        line-height: 1.25;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        white-space: nowrap;
      }
      .records-table td {
        padding: 10px 9px;
        color: #405463;
        border-right: 1px solid #f0f3f5;
        border-bottom: 1px solid #e8edf0;
        font-size: 10px;
        white-space: nowrap;
      }
      .records-table tbody tr:hover td {
        background: #fbfcfd;
      }
      .records-table th:first-child,
      .records-table td:first-child {
        padding-left: 16px;
      }
      .doc-link {
        color: #3e6e96;
        font-weight: 800;
      }
      .project-name {
        font-weight: 700;
        color: #344e60;
      }
      .material-code,
      .customer-code {
        font-weight: 700;
        color: #556c7a;
      }
      .status {
        display: inline-flex;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 8px;
        font-weight: 800;
      }
      .pending {
        background: #f8e9ee;
        color: #95506a;
      }
      .approved {
        background: #e7f3ec;
        color: #477463;
      }
      .progress {
        background: #e9f0f6;
        color: #4e718d;
      }
      .completed {
        background: #e5f2ec;
        color: #3e725f;
      }
      .action-group {
        display: flex;
        gap: 4px;
      }
      .action {
        width: 27px;
        height: 25px;
        border: 1px solid #e0e6ea;
        background: #fff;
        color: #71818d;
        border-radius: 5px;
        display: grid;
        place-items: center;
      }
      .action:hover {
        background: #f6eaf0;
        color: var(--red);
        border-color: #e2ccd5;
      }
      .table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 11px 17px;
        color: #7a8994;
        font-size: 10px;
      }
      .page-size {
        display: flex;
        align-items: center;
        gap: 7px;
      }
      .page-size select {
        height: 29px;
        border: 1px solid #d9e2e7;
        border-radius: 5px;
        font-size: 10px;
        padding: 0 8px;
      }
      .pagination .page-link {
        font-size: 10px;
        color: #617481;
        border-color: #e0e6ea;
      }
      .pagination .active .page-link {
        background: var(--red);
        border-color: var(--red);
        color: #fff;
      }
      @media (max-width: 1100px) {
        .filter-grid {
          grid-template-columns: 1fr 1fr 1fr;
        }
        .filter-actions {
          grid-column: 1/-1;
        }
      }
      @media (max-width: 700px) {
        .top-menu {
          display: none;
        }
        .page {
          padding: 18px 14px;
        }
        .page-title-row {
          flex-direction: column;
          gap: 12px;
        }
        .filter-grid {
          grid-template-columns: 1fr;
        }
        .filter-actions {
          grid-column: auto;
        }
        .profile-name {
          display: none;
        }
      }

      .section-nav {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 15px;
        background: #f8fafb;
        border-bottom: 1px solid #e0e7eb;
        flex-wrap: wrap;
      }
      .section-label {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.65px;
        font-weight: 800;
        color: #6d7d88;
        margin-right: 4px;
      }
      .section-btn {
        border: 1px solid #d8e1e6;
        background: #fff;
        color: #566b78;
        border-radius: 16px;
        padding: 6px 11px;
        font-size: 9px;
        font-weight: 800;
        cursor: pointer;
      }
      .section-btn:hover {
        box-shadow: 0 2px 7px #071b2d12;
      }
      .section-btn.active {
        color: #fff;
        border-color: var(--red);
        background: var(--red);
      }
      .section-btn .dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 5px;
        background: #7991a0;
      }
      .section-btn.tdp .dot {
        background: #6d91b1;
      }
      .section-btn.feas .dot {
        background: #8f7290;
      }
      .section-btn.bom .dot {
        background: #8aa46b;
      }
      .section-btn.sst .dot {
        background: #a27d55;
      }
      .section-btn.eng .dot {
        background: #6d9a9a;
      }
      .section-helper {
        margin-left: auto;
        font-size: 9px;
        color: #81909a;
      }
      .section-panel {
        padding: 10px 15px;
        background: #fff;
        border-bottom: 1px solid #e1e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }
      .section-panel-title {
        font-size: 11px;
        font-weight: 800;
        color: var(--navy);
      }
      .section-panel-desc {
        font-size: 9px;
        color: #81909a;
        margin-top: 2px;
      }
      .section-toggle {
        border: 1px solid #d7e0e5;
        background: #fff;
        color: #627581;
        border-radius: 5px;
        font-size: 9px;
        font-weight: 800;
        padding: 6px 10px;
      }

      .engineering-table-wrap {
        position: relative;
        overflow: auto;
        max-height: 570px;
        scroll-behavior: smooth;
        scrollbar-width: thin;
        scrollbar-color: #aebdc7 #f3f6f8;
      }
      .engineering-table-wrap::-webkit-scrollbar {
        height: 10px;
        width: 10px;
      }
      .engineering-table-wrap::-webkit-scrollbar-track {
        background: #f3f6f8;
      }
      .engineering-table-wrap::-webkit-scrollbar-thumb {
        background: #b5c2ca;
        border-radius: 10px;
      }
      .engineering-table {
        border-collapse: separate;
        border-spacing: 0;
        min-width: 2300px;
        width: max-content;
        table-layout: fixed;
      }
      .engineering-table th,
      .engineering-table td {
        white-space: nowrap;
        position: relative;
      }
      .engineering-table thead {
        position: sticky;
        top: 0;
        z-index: 8;
      }
      .engineering-table thead th {
        border-right: 1px solid #dce4e9;
      }
      .engineering-table tbody td {
        padding: 8px 10px;
      }
      .engineering-table tbody tr:nth-child(even) td {
        background: #fbfcfd;
      }
      .engineering-table tbody tr:hover td {
        background: #f5f9fb;
      }
      .section-end {
        border-right: 2px solid #cbd7de !important;
      }
      .section-nav {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 10px 15px;
        background: #f8fafb;
        border-bottom: 1px solid #e0e7eb;
        flex-wrap: wrap;
      }
      .section-label {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.65px;
        font-weight: 800;
        color: #6d7d88;
        margin-right: 4px;
      }
      .section-btn {
        border: 1px solid #d8e1e6;
        background: #fff;
        color: #566b78;
        border-radius: 16px;
        padding: 6px 11px;
        font-size: 9px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .section-btn:hover {
        background: #f2f6f8;
        transform: translateY(-1px);
      }
      .section-btn.active {
        color: #fff;
        border-color: var(--red);
        background: var(--red);
        box-shadow: 0 2px 7px #e31b2330;
      }
      .section-btn .dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 5px;
        background: #7991a0;
      }
      .section-btn.tdp .dot {
        background: #6d91b1;
      }
      .section-btn.feas .dot {
        background: #8f7290;
      }
      .section-btn.bom .dot {
        background: #8aa46b;
      }
      .section-btn.sst .dot {
        background: #a27d55;
      }
      .section-btn.eng .dot {
        background: #6d9a9a;
      }
      .section-helper {
        margin-left: auto;
        font-size: 9px;
        color: #81909a;
      }
      .section-panel {
        padding: 9px 15px;
        background: #fff;
        border-bottom: 1px solid #e1e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }
      .section-panel-title {
        font-size: 11px;
        font-weight: 800;
        color: var(--navy);
      }
      .section-panel-desc {
        font-size: 9px;
        color: #81909a;
        margin-top: 2px;
      }
      .section-actions {
        display: flex;
        gap: 6px;
        align-items: center;
      }
      .section-toggle,
      .show-all-btn {
        border: 1px solid #d7e0e5;
        background: #fff;
        color: #627581;
        border-radius: 5px;
        font-size: 9px;
        font-weight: 800;
        padding: 6px 10px;
        cursor: pointer;
      }
      .section-toggle:hover,
      .show-all-btn:hover {
        background: #f4f7f8;
        color: var(--navy);
      }
      .section-toggle:disabled {
        cursor: default;
      }
      .section-hidden {
        display: none !important;
      }
      .section-anchor {
        scroll-margin-left: 12px;
      }

      /* =========================================================
  ENGINEERING COLLAPSIBLE SECTION LAYOUT
  ========================================================= */
      .engineering-table-wrap {
        width: 100%;
        height: 560px;
        overflow-x: auto;
        overflow-y: auto;
        background: #f5f7f9;
        border-top: 1px solid #e1e7eb;
        scrollbar-width: thin;
      }

      /* Main horizontal layout */
      .engineering-table {
        display: flex;
        width: 100%;
        min-width: 900px;
        height: 100%;
        background: #fff;
      }

      /* Every section */
      .engineering-section {
        display: flex;
        flex: 0 0 48px;
        height: 100%;
        border-right: 1px solid #d5dfe5;
        background: #fff;
        transition:
          flex-basis 0.28s ease,
          width 0.28s ease;
        overflow: hidden;
      }

      /* Expanded section */
      .engineering-section.expanded {
        flex: 1 1 auto;
        min-width: 360px;
      }

      /* Project gets slightly more width */
      .engineering-section.project-section.expanded {
        min-width: 420px;
      }

      /* =========================================================
  VERTICAL COLLAPSED BAR
  ========================================================= */
      .section-vertical-bar {
        flex: 0 0 48px;
        width: 48px;
        height: 100%;
        border: 0;
        border-right: 1px solid rgba(7, 27, 45, 0.12);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 13px;
        padding: 10px 5px;
        color: #fff;
        transition: all 0.18s ease;
        position: relative;
      }

      /* Vertical text */
      .vertical-text {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.8px;
        white-space: nowrap;
      }

      /* Icon */
      .vertical-icon {
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Hover */
      .section-vertical-bar:hover {
        filter: brightness(0.94);
      }

      /* =========================================================
  SECTION COLORS
  ========================================================= */
      .project-bar {
        background: #71879a;
      }
      .tdp-bar {
        background: #668aaa;
      }
      .feas-bar {
        background: #8b718f;
      }
      .bom-bar {
        background: #7e9b67;
      }
      .sst-bar {
        background: #a07b55;
      }
      .eng-bar {
        background: #668f8f;
      }

      /* =========================================================
  CONTENT AREA
  ========================================================= */
      .section-content {
        flex: 1;
        min-width: 0;
        overflow-x: auto;
        overflow-y: hidden;
        background: #fff;
      }

      /* Hide content when collapsed */
      .engineering-section:not(.expanded) .section-content {
        display: none;
      }

      /* =========================================================
  SECTION HEADER
  ========================================================= */
      .section-header {
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 10px;
        color: #fff;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.25px;
        position: sticky;
        top: 0;
        z-index: 4;
      }

      /* Section header colors */
      .project-header {
        background: #71879a;
      }
      .tdp-header {
        background: #668aaa;
      }
      .feas-header {
        background: #8b718f;
      }
      .bom-header {
        background: #7e9b67;
      }
      .sst-header {
        background: #a07b55;
      }
      .eng-header {
        background: #668f8f;
      }

      /* Collapse button */
      .section-collapse {
        width: 27px;
        height: 27px;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: all 0.15s ease;
      }

      .section-collapse:hover {
        background: rgba(255, 255, 255, 0.25);
      }

      /* =========================================================
  INNER TABLE
  ========================================================= */
      .section-content table {
        width: 100%;
        border-collapse: collapse;
        table-layout: auto;
      }

      .section-content th {
        height: 43px;
        padding: 8px 10px;
        background: #f0f4f6;
        border-right: 1px solid #d9e1e6;
        border-bottom: 1px solid #ccd8df;
        color: #536b79;
        font-size: 8px;
        line-height: 1.25;
        font-weight: 800;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .section-content td {
        height: 40px;
        padding: 8px 10px;
        border-right: 1px solid #e4eaee;
        border-bottom: 1px solid #e5ebee;
        color: #405463;
        font-size: 10px;
        white-space: nowrap;
      }

      .section-content tbody tr:nth-child(even) td {
        background: #fafcfd;
      }

      .section-content tbody tr:hover td {
        background: #f2f7fa;
      }

      /* =========================================================
  ACTIVE SECTION
  ========================================================= */
      .engineering-section.expanded {
        box-shadow: inset 0 3px 0 rgba(169, 21, 61, 0.15);
      }

      /* =========================================================
