       */
      function expandAllSections() {
        Object.keys(sectionColumns).forEach((section) => {
          collapsedSections[section] = false;
          sectionColumns[section].forEach((columnNumber) => {
            document
              .querySelectorAll(
                `.engineering-table tr > *:nth-child(${columnNumber})`,
              )
              .forEach((cell) => {
                cell.classList.remove("section-hidden");
              });
          });

          const header = document.querySelector(
            `.collapsible-group[data-section="${section}"]`,
          );
          const chevron = document.getElementById(`chevron-${section}`);

          if (header) {
            header.classList.remove("collapsed");
          }

          if (chevron) {
            chevron.className = "bi bi-chevron-down section-chevron";
          }
        });
      }

      function exportCSV() {
        let csv =
          "Customer,Part Number,Customer Material Code,Process,TDP Plan Date,TDP Availability,Feasibility Plan Date,Feasibility Actual Date,Feasibility Study,RM BOM,Consumable BOM,HW BOM,BOM Overall,SST Requirements,SST Needed Qualification,Engineering Status,Remarks\n";
        records.forEach(
          (x) =>
            (csv += `${x.customer},${x.part},${x.material},${x.process},${x.tdpPlan},${x.tdpAvail},${x.feasPlan},${x.feasActual},${x.feas},${x.rm},${x.cons},${x.hw},${x.bom},${x.sstReq},${x.sstNeed},${x.eng},${x.remarks}\n`),
        );
        const a = document.createElement("a");
        a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
        a.download = "engineering-records.csv";
        a.click();
      }
      render();
    </script>
  </body>
</html>
