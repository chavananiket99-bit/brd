      /* =========================================================
  COLLAPSIBLE TABLE SECTIONS
  ========================================================= */
      const sectionColumns = {
        tdp: [5, 6, 7],
        feas: [8, 9, 10],
        bom: [11, 12, 13, 14],
        sst: [15, 16],
        eng: [17, 18],
      };
      const collapsedSections = {
        tdp: false,
        feas: false,
        bom: false,
        sst: false,
        eng: false,
      };

      function toggleSection(section) {
        collapsedSections[section] = !collapsedSections[section];
        const isCollapsed = collapsedSections[section];
        /*
         * Hide/show all cells belonging to this section.
         *
         * nth-child is used because the table has a fixed
         * column order.
         */
        sectionColumns[section].forEach((columnNumber) => {
          document
            .querySelectorAll(
              `.engineering-table tr > *:nth-child(${columnNumber})`,
            )
            .forEach((cell) => {
              cell.classList.toggle("section-hidden", isCollapsed);
            });
        });

        /*
         * Update the group header.
         */
        const header = document.querySelector(
          `.collapsible-group[data-section="${section}"]`,
        );
        const chevron = document.getElementById(`chevron-${section}`);

        if (header) {
          header.classList.toggle("collapsed", isCollapsed);
        }

        if (chevron) {
          if (isCollapsed) {
            chevron.className = "bi bi-chevron-right section-chevron";
          } else {
            chevron.className = "bi bi-chevron-down section-chevron";
          }
        }
      }

