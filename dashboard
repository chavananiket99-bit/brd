<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mahindra Engineering Dashboard</title>
    <link
      rel="stylesheet"
      href="https://fontsstorage.blob.core.windows.net/html/css/georama.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <style>
      :root {
        --red: #a9153d;
        --red-soft: #f7e9ee;
        --navy: #071b2d;
        --ink: #243746;
        --muted: #71818d;
        --bg: #f3f6f8;
        --surface: #fff;
        --border: #dce4e9;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Georama-Regular", Arial, sans-serif;
        font-size: 12px;
      }
      .topbar {
        height: 68px;
        background: #fff;
        border-bottom: 2px solid #a9153d;
        box-shadow: 0 1px 5px rgba(7, 27, 45, 0.06);
      }
      .header-inner {
        height: 68px;
      }
      .mahindra-logo img {
        width: 170px;
        height: auto;
      }
      .top-menu {
        display: flex;
        gap: 4px;
        align-items: center;
      }
      .top-menu a {
        color: #465967;
        text-decoration: none;
        padding: 11px 16px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
      }
      .top-menu a:hover,
      .top-menu a.active {
        background: #f5eaf0;
        color: var(--red);
      }
      .top-menu a.active {
        box-shadow: inset 0 -2px 0 var(--red);
      }
      .profile-btn {
        border: 0;
        background: transparent;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 5px 7px;
      }
      .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #a9153d;
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 11px;
      }
      .profile-name {
        font-size: 11px;
        font-weight: 800;
        text-align: left;
      }
      .profile-role {
        font-size: 9px;
        color: #7b8993;
      }
      .dropdown-menu {
        border: 1px solid var(--border);
        box-shadow: 0 8px 24px #071b2d22;
        border-radius: 8px;
      }
      .dropdown-item {
        font-size: 12px;
        padding: 9px 14px;
      }

      .page {
        padding: 22px 28px 36px;
      }
      .title {
        font-weight: 800;
        color: var(--navy);
      }
      .accent {
        height: 3px;
        width: 48px;
        background: var(--red);
        border-radius: 3px;
      }
      .cardx {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 9px #071b2d0d;
      }
      .section-kicker {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--red);
        font-weight: 800;
      }
      .section-title-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
      }
      .soft-red {
        background: #fff3f3;
        border: 1px solid #f3c7ca;
      }
      .soft-blue {
        background: #eef6fb;
        border: 1px solid #cfe2ef;
      }
      .soft-teal {
        background: #edf8f8;
        border: 1px solid #cbe8e9;
      }

      .filter {
        padding: 14px;
      }
      .form-label {
        font-size: 10px;
        text-transform: uppercase;
        font-weight: 800;
        color: var(--muted);
        letter-spacing: 0.55px;
      }
      .form-select {
        font-size: 13px;
        border-color: #cbd5df;
      }
      .btn-red {
        background: var(--red);
        color: #fff;
        border-color: var(--red);
      }
      .btn-red:hover {
        background: #c7131a;
        color: #fff;
      }
      .kpi {
        padding: 17px 18px;
        position: relative;
        overflow: hidden;
        height: 100%;
      }
      .kpi:before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: var(--red);
      }
      .kpi-label {
        font-size: 10px;
        text-transform: uppercase;
        font-weight: 800;
        color: var(--muted);
      }
      .kpi-value {
        font-size: 28px;
        font-weight: 900;
        color: var(--navy);
      }
      .kpi-note {
        font-size: 11px;
        color: var(--muted);
      }
      .iconbox {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #edf4f8;
        color: var(--navy);
        font-size: 18px;
      }
      .panel-head {
        padding: 14px 17px;
        border-bottom: 1px solid var(--border);
      }
      .panel-body {
        padding: 17px;
      }
      .gate {
        cursor: pointer;
        transition: 0.15s;
        height: 100%;
        overflow: hidden;
      }
      .gate:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 18px #071b2d18;
      }
      .gate-head {
        padding: 10px 13px;
        font-weight: 800;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
      }
      .g1 {
        background: #e8f0f6;
        color: #315a78;
        border-left: 4px solid #5f89a6;
      }
      .g2 {
        background: #f4e9ed;
        color: #7d4055;
        border-left: 4px solid #b47a8d;
      }
      .g3 {
        background: #e9eef7;
        color: #3f5f8a;
        border-left: 4px solid #7894b8;
      }
      .g4 {
        background: #e7f2f1;
        color: #3e706b;
        border-left: 4px solid #6ca39c;
      }
      .gate-head i {
        opacity: 0.75;
      }
      .stat {
        padding: 9px 12px;
        border-bottom: 1px solid #edf1f4;
      }
      .stat:last-child {
        border: 0;
      }
      .stat small {
        color: var(--muted);
      }
      .pending {
        color: var(--danger);
        font-weight: 800;
      }
      .complete {
        color: var(--green);
        font-weight: 800;
      }
      .progress {
        height: 7px;
      }
      .table-wrap {
        overflow: auto;
      }
      .table {
        margin: 0;
        min-width: 1200px;
      }
      .table thead th {
        background: var(--navy);
        color: #fff;
        font-size: 10px;
        text-transform: uppercase;
        white-space: nowrap;
        vertical-align: middle;
      }
      .table td {
        font-size: 12px;
        vertical-align: middle;
      }
      .table tbody tr:hover {
        background: #f5f9fb;
      }
      .total td {
        background: #e8f2f7 !important;
        font-weight: 900;
        border-top: 2px solid var(--navy);
      }
      .badge-p {
        background: #fff4d5;
        color: #8a6500;
      }
      .badge-c {
        background: #e7f5ed;
        color: #147a46;
      }
      .clickhint {
        font-size: 11px;
        color: var(--muted);
      }
      .hidden {
        display: none !important;
      }
      .modal-header {
        background: var(--navy);
        color: #fff;
      }
      .modal-header .btn-close {
        filter: invert(1);
      }
      .alertbar {
        border-left: 4px solid var(--red);
        background: #fff8f8;
      }
      .chart-row {
        align-items: stretch;
      }
      .chart-card {
        height: 285px;
        overflow: hidden;
      }
      .chart-head {
        min-height: 55px;
        padding: 11px 15px;
      }
      .chart-body {
        height: 215px;
        padding: 7px 14px 12px;
      }
      .donut-body {
        padding: 3px 18px 7px;
      }
      .chart-body canvas {
        width: 100% !important;
        height: 100% !important;
      }
      @media (max-width: 991px) {
        .chart-card {
          height: 270px;
        }
      }
      @media (max-width: 991px) {
        .top-menu {
          display: none;
        }
        .profile-name {
          display: none;
        }
      }
      @media (max-width: 767px) {
        .page {
          padding: 16px;
        }
        .topbar .container-fluid {
          padding: 10px 16px !important;
        }
        .logo-caption {
          display: none;
        }
      }

      .table-section-head {
        padding: 18px 18px 12px;
      }
      .table-section-title {
        font-size: 19px;
        font-weight: 700;
        color: var(--navy);
        margin: 0;
      }
      .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 0 18px 13px;
      }
      .table-search {
        position: relative;
        width: 340px;
        max-width: 100%;
      }
      .table-search i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #8a99a5;
        font-size: 13px;
      }
      .table-search input {
        width: 100%;
        height: 36px;
        padding: 7px 12px 7px 34px;
        border: 1px solid #dce4e9;
        border-radius: 6px;
        background: #fff;
        font-size: 11px;
      }
      .table-search input:focus {
        outline: none;
        border-color: #b77b91;
        box-shadow: 0 0 0 3px rgba(169, 21, 61, 0.07);
      }
      .table-count {
        color: #657786;
        font-size: 11px;
        white-space: nowrap;
      }
      .eng-table-wrap {
        overflow: auto;
        border-top: 1px solid #e1e7eb;
      }
      .eng-table {
        width: 100%;
        min-width: 1450px;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
      }
      .eng-table thead th {
        background: #f6f8fa;
        color: #657786;
        border-bottom: 1px solid #dfe6eb;
        border-right: 1px solid #edf1f4;
        padding: 10px 11px;
        font-size: 9px;
        line-height: 1.25;
        text-transform: uppercase;
        letter-spacing: 0.35px;
        font-weight: 800;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 2;
      }
      .eng-table thead th:first-child {
        padding-left: 18px;
      }
      .eng-table tbody td {
        background: #fff;
        color: #405463;
        border-bottom: 1px solid #e7ecef;
        border-right: 1px solid #f0f3f5;
        padding: 10px 11px;
        font-size: 10.5px;
        line-height: 1.35;
        white-space: nowrap;
      }
      .eng-table tbody td:first-child {
        padding-left: 18px;
      }
      .eng-table tbody tr:hover td {
        background: #fbfcfd;
      }
      .project-link {
        color: #3b6f9c;
        font-weight: 700;
        text-decoration: none;
      }
      .project-link:hover {
        color: #9f183c;
        text-decoration: underline;
      }
      .cell-complete {
        color: #477463;
        font-weight: 700;
      }
      .cell-pending {
        color: #a15b6f;
        font-weight: 800;
      }
      .cell-zero {
        color: #98a4ad;
      }
      .table-action {
        width: 30px;
        height: 27px;
        border: 1px solid #e0e6ea;
        background: #fff;
        color: #72828e;
        border-radius: 5px;
        display: inline-grid;
        place-items: center;
        margin-right: 3px;
      }
      .table-action:hover {
        background: #f6eaf0;
        color: #9f183c;
        border-color: #e4cbd5;
      }
      .project-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
      }
      .project-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #a9153d;
        display: inline-block;
      }
      .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 18px;
        color: #7a8994;
        font-size: 10px;
      }
      .table-note {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .legend-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
      }
      .legend-dot.pending {
        background: #a15b6f;
      }
      .legend-dot.complete {
        background: #477463;
      }
      /* Project & Scope Details: collapse/expand */
      .project-scope-content.collapsed {
        display: none;
      }
      .project-scope-toggle {
        border: 1px solid var(--border);
        background: #fff;
        color: var(--navy);
        border-radius: 6px;
        padding: 7px 11px;
        font-size: 11px;
        font-weight: 700;
      }
      .project-scope-toggle:hover {
        background: var(--red-soft);
        color: var(--red);
      }
      /* Sortable column headers */
      .eng-table thead th[data-sort-key] {
        cursor: pointer;
        user-select: none;
      }
      .eng-table thead th[data-sort-key]:hover {
        background: #e9eef2;
        color: var(--red);
      }
      .sort-indicator {
        display: inline-block;
        margin-left: 5px;
        color: #a9153d;
        font-size: 10px;
      }
      /* Stable widths for the two frozen columns */
      .eng-table {
        table-layout: fixed;
      }
      .eng-table th:nth-child(1),
      .eng-table td:nth-child(1) {
        width: 170px;
        min-width: 170px;
        max-width: 170px;
      }
      .eng-table th:nth-child(2),
      .eng-table td:nth-child(2) {
        width: 95px;
        min-width: 95px;
        max-width: 95px;
      }
      /* Freeze Project and Scope during horizontal scrolling */
      .eng-table thead th:nth-child(1),
      .eng-table thead th:nth-child(2) {
        position: sticky;
        background: #f6f8fa;
        z-index: 6;
      }
      .eng-table thead th:nth-child(1) {
        left: 0;
      }
      .eng-table thead th:nth-child(2) {
        left: 170px;
        box-shadow: 3px 0 4px -3px #071b2d55;
      }
      .eng-table tbody td:nth-child(1),
      .eng-table tbody td:nth-child(2),
      .eng-table tfoot td:nth-child(1),
      .eng-table tfoot td:nth-child(2) {
        position: sticky;
        background: #fff;
        z-index: 3;
      }
      .eng-table tbody td:nth-child(1),
      .eng-table tfoot td:nth-child(1) {
        left: 0;
      }
      .eng-table tbody td:nth-child(2),
      .eng-table tfoot td:nth-child(2) {
        left: 170px;
        box-shadow: 3px 0 4px -3px #071b2d55;
      }
      /* Preserve row hover and alternating backgrounds on frozen cells */
      .eng-table tbody tr:hover td:nth-child(1),
      .eng-table tbody tr:hover td:nth-child(2) {
        background: #fbfcfd;
      }
      .eng-table tbody tr:nth-child(even) td:nth-child(1),
      .eng-table tbody tr:nth-child(even) td:nth-child(2) {
        background: #fbfcfd;
      }
      /* Calculated total row */
      .eng-table tfoot td {
        padding: 12px 11px;
        background: #e8f2f7;
        color: var(--navy);
        border-top: 2px solid var(--navy);
        border-bottom: 1px solid #d4e0e7;
        font-size: 10.5px;
        font-weight: 900;
        white-space: nowrap;
      }
      .eng-table tfoot td:nth-child(1),
      .eng-table tfoot td:nth-child(2) {
        background: #e8f2f7;
      }
      .eng-table tfoot td:nth-child(2) {
        box-shadow: 3px 0 4px -3px #071b2d55;
      }
      .eng-table tfoot .total-label {
        color: var(--red);
      }
      .table-toolbar .btn {
        font-size: 11px;
        white-space: nowrap;
      }
      /* Hide dashboard filter section */
      .page > .cardx.filter {
        display: none !important;
      }
      /* Keep the toolbar compact and aligned */
      .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 0 18px 13px;
      }
      .table-toolbar-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 12px;
      }
      .table-footer {
        display: none;
      }
      /* Multi-level engineering table headers */
      .eng-table thead .gate-group-row th {
        position: sticky;
        top: 0;
        z-index: 8;
        text-align: center;
        padding: 9px 6px;
        color: #243746;
        font-size: 10px;
        border-right: 1px solid #d5dfe6;
        border-bottom: 1px solid #d5dfe6;
      }
      .eng-table thead tr:nth-child(2) th {
        top: 34px;
        z-index: 7;
        white-space: normal;
        text-align: center;
        padding: 8px 6px;
        font-size: 9px;
      }
      .eng-table thead .group-project {
        background: #dce7ee;
      }
      .eng-table thead .group-g1 {
        background: #c5e2f1;
      }
      .eng-table thead .group-g2 {
        background: #eadfe9;
      }
      .eng-table thead .group-g3 {
        background: #d9d9f2;
      }
      .eng-table thead .group-g4 {
        background: #d5e8dc;
      }
      /* Keep the frozen Project and Scope headers above other cells */
      .eng-table thead tr:nth-child(2) th:nth-child(1),
      .eng-table thead tr:nth-child(2) th:nth-child(2) {
        z-index: 10;
      }
      .eng-table thead .gate-group-row th:first-child {
        position: sticky;
        left: 0;
        z-index: 12;
      }
      @media (max-width: 767px) {
        .table-toolbar {
          align-items: stretch;
          flex-direction: column;
        }
        .table-search {
          width: 100%;
        }
        .table-toolbar-right {
          justify-content: flex-start;
        }
      }
      @media (max-width: 767px) {
        .eng-table th:nth-child(1),
        .eng-table td:nth-child(1) {
          width: 145px;
          min-width: 145px;
          max-width: 145px;
        }
        .eng-table thead th:nth-child(2),
        .eng-table tbody td:nth-child(2),
        .eng-table tfoot td:nth-child(2) {
          left: 145px;
        }
      }
      @media (max-width: 767px) {
        .table-toolbar {
          align-items: flex-start;
          flex-direction: column;
        }
        .table-search {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container-fluid px-4">
        <div
          class="header-inner d-flex align-items-center justify-content-between gap-3"
        >
          <a class="mahindra-logo" href="#"
            ><img src="mahindra_rise_red.png" alt="Mahindra"
          /></a>
          <nav class="top-menu">
            <a href="mahindra_engineering_dashboard.html" class="active"
              ><i class="bi bi-grid-1x2 me-1"></i>Dashboard</a
            >
            <a href="mahindra_engineering_input_bd.html"
              ><i class="bi bi-folder2-open me-1"></i>Input BD</a
            >
            <a href="mahindra_programs.html"
              ><i class="bi bi-folder2-open me-1"></i>Mahindra Programs</a
            >
            <a href="mahindra_engineering_records.html"
              ><i class="bi bi-folder2-open me-1"></i>Engineering 1</a
            >
            <a href="mahindra_engineering_records_new.html"
              ><i class="bi bi-folder2-open me-1"></i>Engineering 2</a
            >
            <a href="#"><i class="bi bi-bar-chart-line me-1"></i>Reports</a>
          </nav>
          <div class="dropdown">
            <button
              class="profile-btn dropdown-toggle"
              data-bs-toggle="dropdown"
            >
              <div>
                <div class="profile-name">Priyank Jain</div>
                <div class="profile-role">Engineering User</div>
              </div>
              <span class="avatar">PJ</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end mt-2">
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-person me-2"></i>My Profile</a
                >
              </li>
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-gear me-2"></i>Settings</a
                >
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item text-danger" href="#"
                  ><i class="bi bi-box-arrow-right me-2"></i>Logout</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </header>

    <main class="page container-fluid">
      <div class="section-title-row mb-3">
        <div>
          <div class="section-kicker">Engineering • Portfolio</div>
          <h5 class="title mb-1">Portfolio Overview</h5>
          <div class="accent"></div>
        </div>
        <div class="small text-muted">
          <i class="bi bi-clock me-1"></i>Last refreshed: 07-Oct-2026
        </div>
      </div>

      <section class="cardx filter mb-4">
        <div class="row g-3 align-items-end">
          <div class="col-12 col-md-3">
            <label class="form-label">Project</label>
            <select id="project" class="form-select">
              <option value="ALL">All Projects</option>
              <option>ASA NP1.1</option>
              <option>ASA W1</option>
