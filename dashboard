      const dashboardMain = document.querySelector("main.page");
      const filterSection = dashboardMain.querySelector(".cardx.filter");
      if (projectScopeSection && filterSection) {
        filterSection.after(projectScopeSection);
      }

      function pick(p) {
        document.getElementById("project").value = p;
        render();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
      let sortState = {
        key: null,
        direction: "asc",
      };
      const gatePendingColumns = {
        G1: ["tdpp", "fp"],
        G2: ["pbp", "sstp"],
        G3: ["laip", "fpqp", "tcp", "tdp"],
        G4: ["cp", "mp"],
      };
      function setupSortableHeaders() {
        const headers = document.querySelectorAll("#projectTable thead th");
        headers.forEach((th, index) => {
          // Project, Scope, and all numeric data columns are sortable.
          if (index === 0) {
            th.dataset.sortKey = "p";
          } else if (index === 1) {
            th.dataset.sortKey = "scope";
          } else if (index >= 2 && index < 2 + cols.length) {
            th.dataset.sortKey = cols[index - 2][0];
          } else {
            delete th.dataset.sortKey;
            return; // Do not sort the Action column.
          }
          th.setAttribute("title", "Click to sort ascending or descending");
          if (!th.querySelector(".sort-indicator")) {
            const indicator = document.createElement("span");
            indicator.className = "sort-indicator";
            indicator.textContent = "↕";
            th.appendChild(indicator);
          }
          th.onclick = () => {
            const key = th.dataset.sortKey;
            if (sortState.key === key) {
              sortState.direction =
                sortState.direction === "asc" ? "desc" : "asc";
            } else {
              sortState.key = key;
              sortState.direction = "asc";
            }
            updateSortIndicators();
            render();
          };
        });
        updateSortIndicators();
      }
      function updateSortIndicators() {
        document
          .querySelectorAll("#projectTable thead th[data-sort-key]")
          .forEach((th) => {
            const indicator = th.querySelector(".sort-indicator");
            if (!indicator) return;
            if (th.dataset.sortKey !== sortState.key) {
              indicator.textContent = "↕";
              indicator.setAttribute("aria-label", "Not sorted");
            } else {
              indicator.textContent = sortState.direction === "asc" ? "↑" : "↓";
              indicator.setAttribute(
                "aria-label",
                sortState.direction === "asc" ? "Ascending" : "Descending",
              );
            }
          });
      }
      function getFilteredRows() {
        const selectedProject = document.getElementById("project").value;
        const selectedGate = document.getElementById("gate").value;
        const selectedStatus = document.getElementById("status").value;
        const query = (document.getElementById("tableSearch")?.value || "")
          .trim()
          .toLowerCase();
        return data.filter((x) => {
          const projectMatch =
            selectedProject === "ALL" || x.p === selectedProject;
          const textMatch =
            !query ||
            [x.p, ...cols.map(([key]) => x[key])].some((value) =>
              String(value ?? "")
                .toLowerCase()
                .includes(query),
            );
          const pendingKeys =
            selectedGate === "ALL"
              ? [
                  "tdpp",
                  "fp",
                  "pbp",
                  "sstp",
                  "laip",
                  "fpqp",
                  "tcp",
                  "tdp",
                  "cp",
                  "mp",
                ]
              : gatePendingColumns[selectedGate];
          const hasPending = pendingKeys.some((key) => Number(x[key]) > 0);
          const statusMatch =
            selectedStatus === "ALL" ||
            (selectedStatus === "PENDING" && hasPending) ||
            (selectedStatus === "COMPLETE" && !hasPending);
          return projectMatch && textMatch && statusMatch;
        });
      }
      function getSortedRows(rows) {
        const sorted = [...rows];
        if (!sortState.key) return sorted;
        sorted.sort((a, b) => {
          const av = a[sortState.key];
          const bv = b[sortState.key];
          let result;
          if (typeof av === "number" && typeof bv === "number") {
            result = av - bv;
          } else {
            result = String(av ?? "").localeCompare(
              String(bv ?? ""),
              undefined,
              { numeric: true, sensitivity: "base" },
            );
          }
          return sortState.direction === "asc" ? result : -result;
        });
        return sorted;
      }
      function render() {
        const rows = getFilteredRows();
        const sortedRows = getSortedRows(rows);
        const tbody = document.querySelector("#projectTable tbody");
        tbody.innerHTML = "";
        sortedRows.forEach((x) => {
          const tr = document.createElement("tr");
          const projectCell = document.createElement("td");
          const projectButton = document.createElement("button");
          projectButton.type = "button";
          projectButton.className = "btn btn-link btn-sm p-0 project-link";
          projectButton.textContent = x.p;
          projectButton.onclick = () => pick(x.p);
          const projectPill = document.createElement("span");
          projectPill.className = "project-pill";
          const dot = document.createElement("span");
          dot.className = "project-dot";
          projectPill.append(dot, projectButton);
          projectCell.appendChild(projectPill);
          tr.appendChild(projectCell);
          const scopeCell = document.createElement("td");
          scopeCell.textContent = Number(x.scope).toLocaleString("en-IN");
          tr.appendChild(scopeCell);
          cols.forEach(([key]) => {
            const td = document.createElement("td");
            const value = Number(x[key]) || 0;
            const isPending = key.endsWith("p");
            td.className = isPending
              ? value > 0
                ? "cell-pending"
                : "cell-zero"
              : "cell-complete";
            td.textContent = value.toLocaleString("en-IN");
            tr.appendChild(td);
          });

          tbody.appendChild(tr);
        });
        renderTotals(rows);
        document.getElementById("tableCount").textContent = rows.length;
        updateSortIndicators();
      }
      function renderTotals(rows) {
        const foot = document.getElementById("projectTableFoot");
        if (!foot) return;
        const totals = {};
        // Calculate each numeric column from the filtered records.
        ["scope", ...cols.map(([key]) => key)].forEach((key) => {
          totals[key] = rows.reduce(
            (sum, row) => sum + (Number(row[key]) || 0),
            0,
          );
        });
        const tr = document.createElement("tr");
        const label = document.createElement("td");
        label.className = "total-label";
        label.textContent = `TOTAL (${rows.length} projects)`;
        tr.appendChild(label);
        const scope = document.createElement("td");
        scope.textContent = totals.scope.toLocaleString("en-IN");
        tr.appendChild(scope);
        cols.forEach(([key]) => {
          const td = document.createElement("td");
          td.textContent = totals[key].toLocaleString("en-IN");
          tr.appendChild(td);
        });
        foot.replaceChildren(tr);
      }
      function toggleProjectScope() {
        const content = document.getElementById("projectScopeContent");
        const button = document.getElementById("projectScopeToggle");
        const collapsed = content.classList.toggle("collapsed");
        button.setAttribute("aria-expanded", String(!collapsed));
        button.innerHTML = collapsed
          ? '<i class="bi bi-chevron-down me-1"></i>Expand'
          : '<i class="bi bi-chevron-up me-1"></i>Collapse';
      }
      function refreshDashboard() {
        render();
      }
      function resetAll() {
        document.getElementById("project").value = "ALL";
        document.getElementById("gate").value = "ALL";
        document.getElementById("status").value = "ALL";
        document.getElementById("tableSearch").value = "";
        sortState = { key: null, direction: "asc" };
        updateSortIndicators();
        render();
      }
      function exportCsv() {
        const rows = getSortedRows(getFilteredRows());
        const headers = [
          "Project",
          "Scope",
          ...cols.map(([key, label]) => label),
        ];
        function csvEscape(value) {
          return `"${String(value ?? "").replace(/"/g, '""')}"`;
        }
        const lines = [headers.map(csvEscape).join(",")];
        rows.forEach((row) => {
          lines.push(
            [row.p, row.scope, ...cols.map(([key]) => row[key])]
              .map(csvEscape)
              .join(","),
          );
        });
        const totals = [
          `TOTAL (${rows.length} projects)`,
          ...["scope", ...cols.map(([key]) => key)].map((key) =>
            rows.reduce((sum, row) => sum + (Number(row[key]) || 0), 0),
          ),
        ];
        lines.push(totals.map(csvEscape).join(","));
        const blob = new Blob(["\uFEFF" + lines.join("\r\n")], {
          type: "text/csv;charset=utf-8;",
        });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = "mahindra-engineering-dashboard.csv";
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }
      // Initialize the table after the data and column definitions.
      setupSortableHeaders();
