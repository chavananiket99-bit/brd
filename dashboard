      function render() {
        const selected = document.getElementById("project").value,
          status = document.getElementById("status").value;
        const rows = data.filter((x) => selected === "ALL" || x.p === selected);
        const tbody = document.querySelector("#projectTable tbody");
        tbody.innerHTML = "";
        rows.forEach((x) => {
          const tr = document.createElement("tr");
          tr.innerHTML =
            `<td><button class="btn btn-link btn-sm p-0 fw-bold text-decoration-none" onclick="pick('${x.p}')">${x.p}</button></td><td>${x.scope}</td>` +
            cols
              .map(
                ([k]) =>
                  `<td class="${k.endsWith("p") ? "pending" : ""}">${x[k]}</td>`,
              )
              .join("");
          if (
            status === "PENDING" &&
            !Object.keys(x).some((k) => k.endsWith("p") && x[k] > 0)
          )
            return;
          if (
            status === "COMPLETE" &&
            Object.keys(x).some((k) => k.endsWith("p") && x[k] > 0)
          )
            return;
          tbody.appendChild(tr);
        });
      }
      function pick(p) {
        document.getElementById("project").value = p;
        render();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
