<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mahindra Programs – Records</title>
    <link
      rel="stylesheet"
      href="https://fontsstorage.blob.core.windows.net/html/css/georama.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    />
    <style>
      :root {
        --red: #a9153d;
        --red-soft: #f7e9ee;
        --navy: #071b2d;
        --ink: #243746;
        --muted: #71818d;
        --bg: #f3f6f8;
        --surface: #fff;
        --border: #dce4e9;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Georama-Regular", Arial, sans-serif;
        font-size: 12px;
      }
      .topbar {
        height: 68px;
        background: #fff;
        border-bottom: 2px solid #a9153d;
        box-shadow: 0 1px 5px rgba(7, 27, 45, 0.06);
      }
      .header-inner {
        height: 68px;
      }
      .mahindra-logo img {
        width: 170px;
        height: auto;
      }
      .top-menu {
        display: flex;
        gap: 4px;
        align-items: center;
      }
      .top-menu a {
        color: #465967;
        text-decoration: none;
        padding: 11px 16px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
      }
      .top-menu a:hover,
      .top-menu a.active {
        background: #f5eaf0;
        color: var(--red);
      }
      .top-menu a.active {
        box-shadow: inset 0 -2px 0 var(--red);
      }
      .profile-btn {
        border: 0;
        background: transparent;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 5px 7px;
      }
      .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #a9153d;
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 11px;
      }
      .profile-name {
        font-size: 11px;
        font-weight: 800;
        text-align: left;
      }
      .profile-role {
        font-size: 9px;
        color: #7b8993;
      }
      .dropdown-menu {
        border: 1px solid var(--border);
        box-shadow: 0 8px 24px #071b2d22;
        border-radius: 8px;
      }
      .dropdown-item {
        font-size: 12px;
        padding: 9px 14px;
      }
      .page {
        padding: 24px 28px 40px;
        max-width: 1600px;
        margin: auto;
      }
      .breadcrumb {
        font-size: 10px;
        color: #82909a;
        margin-bottom: 7px;
      }
      .page-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 17px;
      }
      .page-title {
        font-size: 23px;
        font-weight: 800;
        color: var(--navy);
        margin: 0;
      }
      .page-subtitle {
        font-size: 11px;
        color: #71818d;
        margin-top: 5px;
      }
      .title-accent {
        height: 3px;
        width: 45px;
        background: var(--red);
        border-radius: 3px;
        margin-top: 9px;
      }
      .header-actions,
      .table-tools,
      .action-group {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }
      .btn-light-action,
      .tool-btn {
        height: 35px;
        border: 1px solid #d5dfe5;
        background: white;
        color: #526672;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 700;
        padding: 0 12px;
      }
      .btn-primary-mahindra {
        height: 35px;
        background: var(--red);
        border: 1px solid var(--red);
        color: white;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 800;
        padding: 0 14px;
      }
      .summary-strip {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 14px;
      }
      .summary-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 12px 15px;
        min-width: 145px;
        flex: 1;
      }
      .summary-label {
        font-size: 9px;
        text-transform: uppercase;
        color: #71818d;
        font-weight: 800;
      }
      .summary-value {
        font-size: 19px;
        color: var(--navy);
        font-weight: 800;
        margin-top: 4px;
      }
      .filter-card,
      .table-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 9px #071b2d0c;
        margin-bottom: 14px;
      }
      .filter-card {
        padding: 15px 17px;
      }
      .filter-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr auto;
        gap: 11px;
        align-items: end;
      }
      .filter-label {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 800;
        color: #687a87;
        margin-bottom: 5px;
      }
      .filter-control {
        height: 36px;
        border: 1px solid #d5dfe6;
        border-radius: 6px;
        font-size: 11px;
      }
      .filter-actions {
        display: flex;
        gap: 7px;
      }
      .apply {
        height: 36px;
        background: var(--red);
        color: white;
        border: 1px solid var(--red);
        font-size: 10px;
        font-weight: 800;
        padding: 0 15px;
        border-radius: 6px;
      }
      .clear {
        height: 36px;
        border: 1px solid #d5dfe6;
        background: white;
        color: #657682;
        border-radius: 6px;
        width: 38px;
      }
      .table-head {
        padding: 15px 17px 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }
      .table-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--navy);
      }
      .table-meta {
        font-size: 10px;
        color: #7a8994;
        margin-top: 3px;
      }
      .table-wrap {
        overflow: auto;
        border-top: 1px solid #e2e8ec;
      }
      .records-table {
        width: 100%;
        min-width: 1500px;
        border-collapse: separate;
        border-spacing: 0;
      }
      .records-table th {
        background: #f5f7f9;
        color: #627582;
        border-right: 1px solid #edf1f4;
        border-bottom: 1px solid #dce4e9;
        padding: 11px 10px;
        font-size: 8px;
        line-height: 1.3;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .records-table td {
        padding: 10px;
        color: #405463;
        border-right: 1px solid #f0f3f5;
        border-bottom: 1px solid #e8edf0;
        font-size: 10px;
        white-space: nowrap;
      }
      .records-table tbody tr:hover td {
        background: #fbfcfd;
      }
      .editable-cell {
        background: #fffdf3 !important;
      }
      .action {
        width: 29px;
        height: 27px;
        border: 1px solid #e0e6ea;
        background: white;
        color: var(--red);
        border-radius: 5px;
        display: grid;
        place-items: center;
      }
      .action:hover {
        background: var(--red-soft);
      }
      .table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 12px 17px;
        color: #7a8994;
        font-size: 10px;
      }
      .legend {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        font-size: 9px;
        color: #71818d;
      }
      .legend-box {
        width: 10px;
        height: 10px;
        display: inline-block;
        border: 1px solid #e9d89e;
        background: #fffdf3;
        border-radius: 2px;
        margin-right: 4px;
      }
      .modal-content {
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 15px 45px #071b2d26;
      }
      .modal-header {
        background: #f8fafb;
        border-bottom: 1px solid var(--border);
        padding: 17px 20px;
      }
      .modal-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--navy);
      }
      .modal-body {
        padding: 20px;
      }
      .modal-help {
        font-size: 10px;
        color: #71818d;
        margin-top: 4px;
      }
      .modal-fields {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
      }
      .modal-field label {
        display: block;
        font-size: 10px;
        font-weight: 800;
        color: #536777;
        margin-bottom: 6px;
      }
      .modal-field .form-control,
      .modal-field .form-select {
        font-size: 11px;
        min-height: 36px;
        border-color: #d5dfe6;
      }
      .modal-field .form-control:disabled,
      .modal-field .form-select:disabled {
        background: #f2f5f7;
        color: #637481;
        opacity: 1;
      }
      .modal-footer {
        padding: 13px 20px;
        border-top: 1px solid var(--border);
      }
      @media (max-width: 1000px) {
        .top-menu {
          display: none;
        }
        .filter-grid {
          grid-template-columns: 1fr 1fr;
        }
        .modal-fields {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 650px) {
        .page {
          padding: 18px 12px;
        }
        .page-title-row {
          flex-direction: column;
        }
        .filter-grid {
          grid-template-columns: 1fr;
        }
        .profile-name,
        .profile-role {
          display: none;
        }
        .table-head {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
