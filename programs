          orderType: "FAI",
          plannedLaunch: "2024-07-18",
          actualRelease: "2024-08-01",
          plannedSubmission: "2024-09-20",
          actualSubmission: "2024-09-25",
        },
        {
          sr: 11,
          customer: "ATLANTIC",
          project: "ABS",
          material: "Z5393680130600",
          description: "ANGLE",
          subProject: "W1",
          type: "DETAIL PART",
          orderType: "FAI",
          plannedLaunch: "2024-07-18",
          actualRelease: "2024-08-01",
          plannedSubmission: "2024-09-20",
          actualSubmission: "2024-09-25",
        },
      ];
      const modal = new bootstrap.Modal(
        document.getElementById("editProgramModal"),
      );
      const esc = (v) =>
        String(v ?? "").replace(
          /[&<>"']/g,
          (c) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            })[c],
        );
      function shown(col, value) {
        if (col.type === "date" && value) {
          const [y, m, d] = value.split("-");
          return `${m}/${d}/${y}`;
        }
        return value || "—";
      }
      function renderTable() {
        const q = document
            .getElementById("searchText")
            .value.trim()
            .toLowerCase(),
          p = document
            .getElementById("searchProject")
            .value.trim()
            .toLowerCase(),
          o = document.getElementById("filterOrderType").value;
        const found = records
          .map((record, index) => ({ record, index }))
          .filter(
            ({ record: r }) =>
              (!q ||
                r.customer.toLowerCase().includes(q) ||
                r.material.toLowerCase().includes(q)) &&
              (!p || r.project.toLowerCase().includes(p)) &&
              (!o || r.orderType === o),
          );
        document.getElementById("recordBody").innerHTML = found
          .map(
            ({ record: r, index }) =>
              `<tr>${columns.map((c) => `<td class="${c.editable ? "editable-cell" : ""}">${esc(shown(c, r[c.key]))}${c.editable ? '<span class="manual-tag">MANUAL</span>' : ""}</td>`).join("")}<td><div class="action-group"><button type="button" class="action" title="Edit row" aria-label="Edit row ${r.sr}" onclick="openEditModal(${index})"><i class="bi bi-pencil"></i></button></div></td></tr>`,
          )
          .join("");
        document.getElementById("recordCount").textContent = found.length;
        document.getElementById("summaryTotal").textContent = records.length;
        document.getElementById("total").textContent = found.length;
        document.getElementById("showing").textContent = found.length
          ? `1 to ${found.length}`
          : "0";
      }
      function openEditModal(index) {
        const r = records[index];
        document.getElementById("editingIndex").value = index;
        document.getElementById("modalRecordContext").textContent =
          `${r.customer} • ${r.material} — only Manual fields can be changed`;
        document.getElementById("modalFields").innerHTML = columns
          .filter((c) => c.key !== "sr")
          .map((c) => {
            const v = r[c.key] ?? "",
              disabled = c.editable ? "" : "disabled",
              cls = c.editable ? "manual" : "";
            let control;
            if (c.type === "select") {
              const opts = c.options || [];
              control = `<select class="form-select" id="modal_${c.key}" name="${c.key}" ${disabled}>${opts.map((x) => `<option value="${esc(x)}" ${v === x ? "selected" : ""}>${esc(x)}</option>`).join("")}${v && !opts.includes(v) ? `<option selected value="${esc(v)}">${esc(v)}</option>` : ""}</select>`;
            } else
              control = `<input class="form-control" id="modal_${c.key}" name="${c.key}" type="${c.type === "date" ? "date" : "text"}" value="${esc(v)}" ${disabled}>`;
            return `<div class="modal-field ${cls}"><label for="modal_${c.key}">${esc(c.label)} ${c.editable ? '<span class="manual-tag">MANUAL</span>' : '<i class="bi bi-lock-fill ms-1" title="Read only"></i>'}</label>${control}</div>`;
          })
          .join("");
        modal.show();
      }
      document
        .getElementById("editProgramForm")
        .addEventListener("submit", (e) => {
          e.preventDefault();
          const i = Number(document.getElementById("editingIndex").value),
            r = records[i];
          if (!r) return;
          columns
            .filter((c) => c.editable)
            .forEach((c) => {
              const input = document.getElementById(`modal_${c.key}`);
              if (input) r[c.key] = input.value.trim();
            });
          modal.hide();
          renderTable();
          document.getElementById("toastMessage").textContent =
            `Record ${r.sr} updated successfully.`;
          bootstrap.Toast.getOrCreateInstance(
            document.getElementById("saveToast"),
            { delay: 3000 },
          ).show();
        });
      function clearFilters() {
        document.getElementById("searchText").value = "";
        document.getElementById("searchProject").value = "";
        document.getElementById("filterOrderType").value = "";
        renderTable();
      }
      function showManualHelp() {
        alert(
          "Only fields marked MANUAL can be edited. Other fields are locked and will not be changed when you submit.",
        );
      }
      function exportCSV() {
        const quote = (v) => `"${String(v ?? "").replace(/"/g, '""')}"`;
        const csv = [
          columns.map((c) => quote(c.label)).join(","),
          ...records.map((r) => columns.map((c) => quote(r[c.key])).join(",")),
        ].join("\r\n");
        const url = URL.createObjectURL(
          new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" }),
        );
        const a = document.createElement("a");
        a.href = url;
        a.download = "program-records.csv";
        a.click();
        URL.revokeObjectURL(url);
      }
      renderTable();
    </script>
  </body>
</html>
