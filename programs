    <header class="topbar">
      <div class="container-fluid px-4">
        <div
          class="header-inner d-flex align-items-center justify-content-between gap-3"
        >
          <a class="mahindra-logo" href="#"
            ><img src="mahindra_rise_red.png" alt="Mahindra"
          /></a>
          <nav class="top-menu">
            <a href="mahindra_engineering_dashboard.html"
              ><i class="bi bi-grid-1x2 me-1"></i>Dashboard</a
            >
            <a href="mahindra_engineering_input_bd.html"
              ><i class="bi bi-folder2-open me-1"></i>Input BD</a
            >
            <a href="mahindra_programs.html" class="active"
              ><i class="bi bi-folder2-open me-1"></i>Mahindra Programs</a
            >
            <a href="mahindra_engineering_records.html"
              ><i class="bi bi-folder2-open me-1"></i>Engineering 1</a
            >
            <a href="mahindra_engineering_records_new.html"
              ><i class="bi bi-folder2-open me-1"></i>Engineering 2</a
            >
            <a href="#"><i class="bi bi-bar-chart-line me-1"></i>Reports</a>
          </nav>
          <div class="dropdown">
            <button
              class="profile-btn dropdown-toggle"
              data-bs-toggle="dropdown"
            >
              <div>
                <div class="profile-name">Priyank Jain</div>
                <div class="profile-role">Engineering User</div>
              </div>
              <span class="avatar">PJ</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end mt-2">
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-person me-2"></i>My Profile</a
                >
              </li>
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-gear me-2"></i>Settings</a
                >
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item text-danger" href="#"
                  ><i class="bi bi-box-arrow-right me-2"></i>Logout</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </header>
    <main class="page">
      <div class="breadcrumb">
        Home <i class="bi bi-chevron-right mx-1"></i><strong>Programs</strong>
      </div>
      <div class="page-title-row">
        <div>
          <h1 class="page-title">Programs</h1>
          <div class="page-subtitle">
            Review program launch and submission dates.
          </div>
          <div class="title-accent"></div>
        </div>
      </div>

      <section class="filter-card">
        <div class="filter-grid">
          <div>
            <div class="filter-label">Customer / Material Number</div>
            <input
              id="searchText"
              class="form-control filter-control"
              placeholder="Search customer or material number"
            />
          </div>
          <div>
            <div class="filter-label">Project</div>
            <input
              id="searchProject"
              class="form-control filter-control"
              placeholder="Search project"
            />
          </div>
          <div>
            <div class="filter-label">Order Type</div>
            <select id="filterOrderType" class="form-select filter-control">
              <option value="">All order types</option>
              <option>FAI</option>
              <option>DFAI</option>
            </select>
          </div>
          <div class="filter-actions">
            <button class="apply" onclick="renderTable()">
              <i class="bi bi-funnel me-1"></i>Apply</button
            ><button class="clear" onclick="clearFilters()" title="Clear">
              <i class="bi bi-arrow-counterclockwise"></i>
            </button>
          </div>
        </div>
      </section>
      <section class="table-card">
        <div class="table-head">
          <div>
            <div class="table-title">
              Program Records (<span id="recordCount">11</span>)
            </div>
            <div class="table-meta">
              Select the pencil icon to edit a row. Grey fields are locked; pale
              yellow fields are editable.
            </div>
          </div>
          <div class="table-tools">
            <button class="btn-light-action" onclick="exportCSV()">
              <i class="bi bi-download me-1"></i>Export CSV
            </button>
            <button class="tool-btn" onclick="renderTable()">
              <i class="bi bi-arrow-clockwise me-1"></i>Refresh view
            </button>
          </div>
        </div>
        <div class="table-wrap">
          <table class="records-table">
            <thead>
              <tr>
                <th>Sr. No.</th>
                <th>Customer</th>
                <th>Project</th>
                <th>Material Number</th>
                <th>Part Description</th>
                <th>Sub Project Name</th>
                <th>Type</th>
                <th>Order Type</th>
                <th>Planned Launch Date</th>
                <th>Actual Release Date</th>
                <th>Planned Submission Date</th>
                <th>Actual Submission Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="recordBody"></tbody>
          </table>
        </div>
        <div class="table-footer">
          <div>
            Showing <strong id="showing">1 to 11</strong> of
            <strong id="total">11</strong> records
          </div>
        </div>
      </section>
    </main>
    <div
      class="modal fade"
      id="editProgramModal"
      tabindex="-1"
      aria-labelledby="editProgramModalLabel"
      aria-hidden="true"
    >
      <div
        class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"
      >
        <div class="modal-content">
          <div class="modal-header">
            <div>
              <h5 class="modal-title" id="editProgramModalLabel">
                Edit Program Record
              </h5>
            </div>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <form id="editProgramForm">
            <div class="modal-body">
              <div class="modal-fields" id="modalFields"></div>
              <input type="hidden" id="editingIndex" />
            </div>
            <div class="modal-footer">
              <button
                type="button"
                class="btn-light-action"
                data-bs-dismiss="modal"
              >
                Cancel</button
              ><button type="submit" class="btn-primary-mahindra">
                <i class="bi bi-check2 me-1"></i>Submit Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
      <div
        id="saveToast"
        class="toast"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        <div class="toast-header">
          <i class="bi bi-check-circle-fill text-success me-2"></i
          ><strong class="me-auto">Program Records</strong
          ><small>Just now</small
          ><button
            type="button"
            class="btn-close"
            data-bs-dismiss="toast"
          ></button>
        </div>
        <div class="toast-body" id="toastMessage">
          Record updated successfully.
        </div>
      </div>
    </div>
