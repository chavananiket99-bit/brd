        const body = document.getElementById("recordBody");
        body.innerHTML = "";
        rows.forEach((x, i) => {
          body.innerHTML += `<tr><td>${i + 1}</td><td>${x[0]}</td><td class="doc-link">${x[1]}</td><td>${x[2]}</td><td>${x[3]}</td><td class="customer-code">${x[4]}</td><td class="project-name">${x[5]}</td><td class="material-code">${x[6]}</td><td>${x[7]}</td><td>${x[8]}</td><td>${x[9]}</td><td>${x[10]}</td><td>${x[11]}</td><td>${x[12]}</td><td>${x[13]}</td><td><span class="status ${statusClass(x[14])}">${x[14]}</span></td><td><div class="action-group"><button class="action"><i class="bi bi-eye"></i></button><button class="action"><i class="bi bi-pencil"></i></button><button class="action"><i class="bi bi-three-dots"></i></button></div></td></tr>`;
        });
        document.getElementById("recordCount").textContent = rows.length;
        document.getElementById("total").textContent = rows.length;
        document.getElementById("showing").textContent = rows.length
          ? `1 to ${rows.length}`
          : "0";
      }
      function applyFilters() {
        render();
      }
      function clearFilters() {
        ["docNo", "customer", "project", "material"].forEach(
          (id) => (document.getElementById(id).value = ""),
        );
        document.getElementById("status").value = "";
        render();
      }
      function exportCSV() {
        let csv =
          "Sr No,Doc Type,Doc No,Doc Date,Version,Customer Code,Project Name,Material Code,RC Price,NRC Price,NRC Qty,Currency,Valid From,Valid To,Planned Submission,Status\n";
        records.forEach((x, i) => (csv += `${i + 1},${x.join(",")}\n`));
        let a = document.createElement("a");
        a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
        a.download = "engineering-records.csv";
        a.click();
      }
      render();
    </script>
  </body>
</html>
