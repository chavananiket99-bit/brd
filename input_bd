<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mahindra Engineering Records</title>
    <link
      rel="stylesheet"
      href="https://fontsstorage.blob.core.windows.net/html/css/georama.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <style>
      :root {
        --red: #a9153d;
        --red-soft: #f7e9ee;
        --navy: #071b2d;
        --ink: #243746;
        --muted: #71818d;
        --bg: #f3f6f8;
        --border: #dce4e9;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font:
          12px "Georama-Regular",
          Arial,
          sans-serif;
      }
      .topbar {
        height: 68px;
        background: #fff;
        border-bottom: 2px solid var(--red);
        box-shadow: 0 1px 5px #071b2d0f;
      }
      .header-inner {
        height: 68px;
      }
      .mahindra-logo img {
        width: 170px;
        height: auto;
      }
      .top-menu {
        display: flex;
        gap: 3px;
        align-items: center;
      }
      .top-menu a {
        color: #465967;
        text-decoration: none;
        padding: 10px 9px;
        border-radius: 6px;
        font-weight: 700;
        white-space: nowrap;
      }
      .top-menu a:hover,
      .top-menu a.active {
        background: #f5eaf0;
        color: var(--red);
      }
      .profile-btn {
        border: 0;
        background: transparent;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 9px;
      }
      .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--red);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
      }
      .profile-name {
        font-weight: 800;
      }
      .profile-role {
        font-size: 11px;
        color: #7b8993;
      }
      .dropdown-menu {
        border: 1px solid var(--border);
        box-shadow: 0 8px 24px #071b2d22;
        border-radius: 8px;
      }
      .dropdown-item {
        font-size: 12px;
        padding: 9px 14px;
      }
      .page {
        padding: 24px 28px 40px;
        max-width: 1500px;
        margin: auto;
      }
      .title {
        font-weight: 800;
        color: var(--navy);
      }
      .title-accent {
        height: 3px;
        width: 45px;
        background: var(--red);
        border-radius: 3px;
        margin-top: 9px;
        margin-bottom: 16px;
      }
      .filter-card,
      .table-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 9px #071b2d0c;
      }
      .filter-card {
        padding: 15px 17px 16px;
        margin-bottom: 14px;
      }
      .filter-grid {
        display: grid;
        grid-template-columns: 1.35fr 1fr 1fr 1.25fr 1fr auto;
        gap: 11px;
        align-items: end;
      }
      .filter-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 800;
        color: #687a87;
        margin-bottom: 5px;
      }
      .filter-control {
        height: 37px;
        border: 1px solid #d5dfe6;
        border-radius: 6px;
        font-size: 12px;
        color: #415563;
      }
      .filter-actions {
        display: flex;
        gap: 7px;
      }
      .apply,
      .clear {
        height: 37px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 800;
      }
      .apply {
        background: var(--red);
        color: white;
        border: 1px solid var(--red);
        padding: 0 16px;
      }
      .clear {
        border: 1px solid #d5dfe6;
        background: white;
        color: #657682;
        width: 38px;
      }
      .table-card {
        overflow: hidden;
      }
      .table-head {
        padding: 15px 17px 11px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
      }
      .table-heading {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }
      .table-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--navy);
      }
      .table-search {
        width: 280px;
        max-width: 100%;
      }
      .table-search .form-control,
      .table-search .input-group-text {
        border-color: #d7e0e5;
        font-size: 11px;
        height: 32px;
      }
      .table-tools {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
      }
      .tool-btn {
        height: 32px;
        border: 1px solid #d7e0e5;
        background: white;
        border-radius: 6px;
        color: #617481;
        font-size: 10px;
        padding: 0 11px;
        font-weight: 700;
      }
      .tool-icon-btn {
        width: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
      }
      .column-menu {
        min-width: 230px;
        max-height: 350px;
        overflow-y: auto;
        border: 1px solid var(--border);
        border-radius: 8px;
        box-shadow: 0 8px 24px #071b2d22;
        padding: 10px 12px;
      }
      .column-menu .form-check {
        margin: 8px 0;
        font-size: 11px;
      }
      .column-menu .form-check-input:checked {
        background-color: var(--red);
        border-color: var(--red);
      }
      .table-wrap {
        overflow: auto;
        position: relative;
        max-width: 100%;
        border-top: 1px solid #e2e8ec;
      }
      .records-table {
        width: 100%;
        min-width: 1550px;
        border-collapse: separate;
        border-spacing: 0;
      }
      .records-table th {
        background: #f5f7f9;
        color: #627582;
        border-right: 1px solid #edf1f4;
        border-bottom: 1px solid #dce4e9;
        padding: 9px 7px;
        font-size: 11px;
        line-height: 1.25;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        white-space: nowrap;
      }
      .records-table td {
        padding: 9px 7px;
        color: #405463;
        border-right: 1px solid #f0f3f5;
        border-bottom: 1px solid #e8edf0;
        font-size: 12px;
        white-space: nowrap;
      }
      .records-table th:first-child,
      .records-table td:first-child {
        padding-left: 16px;
      }
      .records-table tbody tr:hover td {
        background: #fbfcfd;
      }
      .records-table .column-hidden {
        display: none !important;
      }
      .doc-link {
        color: #3e6e96;
        font-weight: 800;
      }
      .project-name,
      .customer-code,
      .material-code {
        font-weight: 700;
        color: #405b6b;
      }
      .status {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 14px;
        font-size: 9px;
        font-weight: 800;
        border: 1px solid transparent;
        cursor: help;
      }
      .status.pending {
        background: #fff3d9;
        color: #8a6415;
        border-color: #f0dfb7;
      }
      .status.inprogress {
        background: #e8f1fa;
        color: #35648d;
        border-color: #cbddec;
      }
      .status.completed {
        background: #e6f3eb;
        color: #347052;
        border-color: #cbe4d5;
      }
      .status.rejected {
        background: #fbe9e9;
        color: #a73535;
        border-color: #efcccc;
      }
      .action-group {
        display: flex;
        gap: 4px;
      }
      .action {
        width: 27px;
        height: 25px;
        border: 1px solid #e0e6ea;
        background: white;
        color: #71818d;
        border-radius: 5px;
        display: grid;
        place-items: center;
      }
      .action:hover {
        background: #f6eaf0;
        color: var(--red);
        border-color: #e2ccd5;
      }
      .edit-record-btn {
        color: var(--red);
      }
      .table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        padding: 11px 17px;
        color: #7a8994;
        font-size: 10px;
      }
      .footer-controls {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 18px;
        margin-left: auto;
      }
      .page-size {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
      }
      .page-size select {
        height: 29px;
        border: 1px solid #d9e2e7;
        border-radius: 5px;
        font-size: 10px;
        padding: 0 8px;
      }
      .pagination .page-link {
        font-size: 10px;
        color: #617481;
        border-color: #e0e6ea;
      }
      .pagination .active .page-link {
        background: var(--red);
        border-color: var(--red);
        color: white;
      }
      .status-modal .modal-content,
      .progress-modal .modal-content {
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 15px 45px #071b2d26;
        overflow: hidden;
      }
      .status-modal .modal-header {
        background: #f8fafb;
        border-bottom: 1px solid var(--border);
        padding: 17px 20px;
      }
      .status-modal .modal-title,
      .progress-modal .modal-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--navy);
      }
      .status-modal .modal-body {
        padding: 22px 20px;
      }
      .status-modal .form-label {
        font-size: 11px;
        font-weight: 800;
        color: #536777;
      }
      .status-options {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }
      .status-option input {
        position: absolute;
        opacity: 0;
      }
      .status-option label {
        display: inline-flex;
        padding: 9px 13px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: white;
        color: #536777;
        cursor: pointer;
        font-size: 11px;
        font-weight: 700;
      }
      .status-option input:checked + label {
        border-color: var(--red);
        background: var(--red-soft);
        color: var(--red);
      }
      .status-modal textarea {
        min-height: 100px;
        font-size: 12px;
      }
      .status-modal .modal-footer {
        padding: 13px 20px;
        border-top: 1px solid var(--border);
      }
      .btn-light-action,
      .btn-primary-mahindra {
        height: 36px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 800;
        padding: 0 13px;
      }
      .btn-light-action {
        border: 1px solid #d5dfe5;
        background: white;
        color: #526672;
      }
      .btn-primary-mahindra {
        background: var(--red);
        border: 1px solid var(--red);
        color: white;
      }
      .progress-modal .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        border-left: 4px solid var(--red);
      }
      .progress-record-details {
        font-size: 10px;
        color: #627582;
        line-height: 1.8;
      }
      .review-indicator {
        padding: 4px 9px;
        border-radius: 12px;
        background: #fff3d9;
        color: #8a6415;
        font-size: 9px;
        font-weight: 800;
      }
      .progress-modal .modal-body {
        padding: 26px 24px 22px;
      }
      .progress-track-scroll {
        width: 100%;
        overflow-x: auto;
        padding: 5px 4px 14px;
      }
      .progress-track {
        display: flex;
        align-items: flex-start;
        min-width: 850px;
        padding-top: 4px;
      }
      .progress-stage {
        flex: 1;
        min-width: 0;
        position: relative;
        text-align: center;
      }
      .progress-stage:not(:last-child):after {
        content: "";
        position: absolute;
        top: 12px;
        left: calc(50% + 13px);
        width: calc(100% - 26px);
        height: 2px;
        background: #dce4e9;
      }
      .progress-stage.done:not(:last-child):after {
        background: var(--red);
      }
      .progress-stage-circle {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 25px;
        height: 25px;
        margin: 0 auto 9px;
        border: 2px solid #dce4e9;
        border-radius: 50%;
        background: white;
        color: #71818d;
        font-size: 10px;
        font-weight: 800;
      }
      .progress-stage.done .progress-stage-circle {
        background: var(--red);
        border-color: var(--red);
        color: white;
      }
      .progress-stage.current .progress-stage-circle {
        background: var(--red-soft);
        border-color: var(--red);
        color: var(--red);
      }
      .progress-stage-name {
        padding: 0 3px;
        color: #687a87;
        font-size: 9px;
        line-height: 1.4;
        overflow-wrap: anywhere;
      }
      .progress-stage.done .progress-stage-name,
      .progress-stage.current .progress-stage-name {
        color: var(--navy);
        font-weight: 800;
      }
      .progress-stage-state {
        margin-top: 4px;
        color: #85939d;
        font-size: 8px;
      }
      .progress-legend {
        display: flex;
        justify-content: center;
        gap: 22px;
        flex-wrap: wrap;
        margin-top: 12px;
        color: #71818d;
        font-size: 9px;
      }
      .legend-dot {
        display: inline-block;
        width: 9px;
        height: 9px;
        margin-right: 5px;
        border-radius: 50%;
        vertical-align: middle;
      }
      .legend-done {
        background: var(--red);
      }
      .legend-current {
        background: var(--red-soft);
        border: 2px solid var(--red);
      }
      .legend-upcoming {
        background: white;
        border: 1px solid #cbd5dc;
      }
      @media (max-width: 1100px) {
        .filter-grid {
          grid-template-columns: 1fr 1fr 1fr;
        }
        .filter-actions {
          grid-column: 1/-1;
        }
        .top-menu a {
          padding: 8px 5px;
          font-size: 10px;
        }
        .mahindra-logo img {
          width: 135px;
        }
      }
      @media (max-width: 700px) {
        .topbar,
        .header-inner {
          height: auto;
          min-height: 68px;
        }
        .top-menu {
          display: none;
        }
        .page {
          padding: 18px 14px;
        }
        .filter-grid {
          grid-template-columns: 1fr;
        }
        .filter-actions {
          grid-column: auto;
        }
        .profile-name,
        .profile-role {
          display: none;
        }
        .table-head {
          align-items: flex-start;
          flex-direction: column;
        }
        .table-tools {
          width: 100%;
        }
        .table-search {
          width: 100%;
          flex: 1;
          min-width: 150px;
        }
        .table-footer,
        .footer-controls {
          align-items: flex-start;
          flex-direction: column;
        }
        .footer-controls {
          margin-left: 0;
          width: 100%;
        }
        .progress-modal .modal-header {
          align-items: flex-start;
          flex-direction: column;
          padding: 16px;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container-fluid px-4">
        <div
          class="header-inner d-flex align-items-center justify-content-between gap-3"
        >
          <a class="mahindra-logo" href="#"
            ><img src="mahindra_rise_red.png" alt="Mahindra"
          /></a>
          <nav class="top-menu">
            <a href="mahindra_engineering_dashboard.html"
              ><i class="bi bi-grid-1x2 me-1"></i>Dashboard</a
            ><a href="mahindra_engineering_input_bd.html" class="active"
              ><i class="bi bi-folder2-open me-1"></i>Input BD</a
            ><a href="mahindra_programs.html"
              ><i class="bi bi-folder2-open me-1"></i>Mahindra Programs</a
            ><a href="mahindra_engineering_records.html"
              ><i class="bi bi-folder2-open me-1"></i>Engineering 1</a
            ><a href="mahindra_engineering_records_new.html"
              ><i class="bi bi-folder2-open me-1"></i>Engineering 2</a
            ><a href="#"><i class="bi bi-bar-chart-line me-1"></i>Reports</a>
          </nav>
          <div class="dropdown">
            <button
              class="profile-btn dropdown-toggle"
              data-bs-toggle="dropdown"
              type="button"
            >
              <div>
                <div class="profile-name">Priyank Jain</div>
                <div class="profile-role">Engineering User</div>
              </div>
              <span class="avatar">PJ</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end mt-2">
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-person me-2"></i>My Profile</a
                >
              </li>
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-gear me-2"></i>Settings</a
                >
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item text-danger" href="#"
                  ><i class="bi bi-box-arrow-right me-2"></i>Logout</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </header>
    <main class="page">
      <div class="page-title-row">
        <div>
          <h5 class="title mb-1">Input BD Records</h5>
          <div class="title-accent"></div>
        </div>
      </div>
      <section class="filter-card">
        <div class="filter-grid">
          <div>
            <div class="filter-label">Doc No.</div>
            <input
              id="docNo"
              class="form-control filter-control"
              placeholder="Search document number"
            />
          </div>
          <div>
            <div class="filter-label">Customer Code</div>
            <input
              id="customer"
              class="form-control filter-control"
              placeholder="Search customer code"
            />
          </div>
          <div>
            <div class="filter-label">Project Name</div>
            <input
              id="project"
              class="form-control filter-control"
              placeholder="Search project name"
            />
          </div>
          <div>
            <div class="filter-label">Customer Material Code</div>
            <input
              id="material"
              class="form-control filter-control"
              placeholder="Search material code"
            />
          </div>
          <div>
            <div class="filter-label">Status</div>
            <select id="status" class="form-select filter-control">
              <option value="">All</option>
              <option value="Pending">Pending Program Review</option>
              <option value="In Progress">In Progress</option>
              <option value="Complete">Completed / Approved</option>
              <option value="Rejected">Rejected</option>
            </select>
          </div>
          <div class="filter-actions">
            <button class="apply" type="button" onclick="applyFilters()">
              <i class="bi bi-funnel me-1"></i>Apply</button
            ><button
              class="clear"
              type="button"
              onclick="clearFilters()"
              title="Clear"
            >
              <i class="bi bi-arrow-counterclockwise"></i>
            </button>
          </div>
        </div>
      </section>
      <section class="table-card">
        <div class="table-head">
          <div class="table-heading">
            <div class="table-title">Engineering Records</div>
            <div class="input-group input-group-sm table-search">
              <span class="input-group-text bg-white"
                ><i class="bi bi-search"></i></span
              ><input
                type="search"
                id="globalSearch"
                class="form-control"
                placeholder="Search all records..."
                aria-label="Search all records"
                oninput="handleSearch()"
              />
            </div>
          </div>
          <div class="table-tools">
            <button
              type="button"
              class="tool-btn tool-icon-btn"
              onclick="exportCSV()"
              title="Export CSV"
              aria-label="Export CSV"
              data-bs-toggle="tooltip"
            >
              <i class="bi bi-download"></i>
            </button>
            <button
              type="button"
              class="tool-btn tool-icon-btn"
              onclick="document.getElementById('excelUpload').click()"
              title="Upload Excel"
              aria-label="Upload Excel"
              data-bs-toggle="tooltip"
            >
              <i class="bi bi-file-earmark-excel"></i></button
            ><input
              type="file"
              id="excelUpload"
              accept=".xlsx,.xls,.csv"
              hidden
              onchange="uploadExcel(event)"
            />
            <div class="dropdown">
              <button
                type="button"
                class="tool-btn dropdown-toggle"
                id="columnsDropdown"
                data-bs-toggle="dropdown"
                data-bs-auto-close="outside"
                aria-expanded="false"
              >
                <i class="bi bi-layout-three-columns me-1"></i>Columns
              </button>
              <div
                class="dropdown-menu dropdown-menu-end column-menu"
                id="columnOptions"
                aria-labelledby="columnsDropdown"
              >
                <div
                  class="d-flex justify-content-between align-items-center mb-2"
                >
                  <strong>Show / hide columns</strong
                  ><button
                    type="button"
                    class="btn btn-sm btn-link p-0"
                    onclick="toggleAllColumns(true)"
                  >
                    Show all
                  </button>
                </div>
                <div id="columnCheckboxes"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="table-wrap">
          <table class="records-table">
            <thead>
              <tr>
                <th>Sr. No.</th>
                <th>Doc Type</th>
                <th>Doc No.</th>
                <th>Doc Date</th>
                <th>Version No.</th>
                <th>Customer Code</th>
                <th>Project Name</th>
                <th>Customer Material Code</th>
                <th>RC Price</th>
                <th>NRC Price</th>
                <th>NRC Qty</th>
                <th>Currency</th>
                <th>Valid From Date</th>
                <th>Valid To Date</th>
                <th>Planned Submission Date</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="recordBody"></tbody>
          </table>
        </div>
        <div class="table-footer">
