      function updateStickyColumns() {
        const table = document.querySelector(".records-table");
        if (!table) return;
        const rows = table.querySelectorAll("tr");
        rows.forEach((row) =>
          Array.from(row.children).forEach((cell) => {
            cell.style.position = "";
            cell.style.left = "";
            cell.style.zIndex = "";
            cell.style.boxShadow = "";
          }),
        );
        const shown = Array.from(table.tHead.rows[0].cells)
          .filter((th) => getComputedStyle(th).display !== "none")
          .slice(0, 3);
        let left = 0;
        shown.forEach((th) => {
          const idx = Array.from(th.parentElement.children).indexOf(th),
            w = th.getBoundingClientRect().width;
          rows.forEach((row) => {
            const cell = row.children[idx];
            if (cell && getComputedStyle(cell).display !== "none") {
              cell.style.position = "sticky";
              cell.style.left = left + "px";
              cell.style.zIndex =
                row.parentElement.tagName === "THEAD" ? "5" : "3";
              cell.style.background =
                row.parentElement.tagName === "THEAD" ? "#f5f7f9" : "#fff";
              if (shown.indexOf(th) === 2)
                cell.style.boxShadow = "3px 0 5px #071b2d12";
            }
          });
          left += w;
        });
      }
      function exportCSV() {
        const csvHeaders = ["Sr No", ...headers.slice(1, 16), "Remarks"],
          esc = (v) => `"${String(v ?? "").replace(/"/g, '""')}"`,
          data = getFilteredRows().map(({ record: r }, i) => [
