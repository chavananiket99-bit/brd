<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mahindra Engineering Records</title>
    <link
      rel="stylesheet"
      href="https://fontsstorage.blob.core.windows.net/html/css/georama.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <style>
      :root {
        --red: #a9153d;
        --red-soft: #f7e9ee;
        --navy: #071b2d;
        --ink: #243746;
        --muted: #71818d;
        --bg: #f3f6f8;
        --surface: #fff;
        --border: #dce4e9;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Georama-Regular", Arial, sans-serif;
        font-size: 12px;
      }
      .topbar {
        height: 68px;
        background: #fff;
        border-bottom: 2px solid #a9153d;
        box-shadow: 0 1px 5px rgba(7, 27, 45, 0.06);
      }
      .header-inner {
        height: 68px;
      }
      .mahindra-logo img {
        width: 170px;
        height: auto;
      }
      .top-menu {
        display: flex;
        gap: 4px;
        align-items: center;
      }
      .top-menu a {
        color: #465967;
        text-decoration: none;
        padding: 11px 16px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
      }
      .top-menu a:hover,
      .top-menu a.active {
        background: #f5eaf0;
        color: var(--red);
      }
      .top-menu a.active {
        box-shadow: inset 0 -2px 0 var(--red);
      }
      .profile-btn {
        border: 0;
        background: transparent;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 5px 7px;
      }
      .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #a9153d;
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 11px;
      }
      .profile-name {
        font-size: 11px;
        font-weight: 800;
        text-align: left;
      }
      .profile-role {
        font-size: 9px;
        color: #7b8993;
      }
      .dropdown-menu {
        border: 1px solid var(--border);
        box-shadow: 0 8px 24px #071b2d22;
        border-radius: 8px;
      }
      .dropdown-item {
        font-size: 12px;
        padding: 9px 14px;
      }

      .page {
        padding: 24px 28px 40px;
        max-width: 1500px;
        margin: auto;
      }
      .breadcrumb {
        font-size: 10px;
        color: #82909a;
        margin-bottom: 7px;
      }
      .breadcrumb strong {
        color: #4e6270;
      }
      .page-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
      }
      .page-title {
        font-size: 23px;
        font-weight: 800;
        color: var(--navy);
        margin: 0;
      }
      .page-subtitle {
        font-size: 11px;
        color: #71818d;
        margin-top: 5px;
      }
      .title-accent {
        height: 3px;
        width: 45px;
        background: var(--red);
        border-radius: 3px;
        margin-top: 9px;
      }
      .header-actions {
        display: flex;
        gap: 8px;
      }
      .btn-light-action {
        height: 36px;
        border: 1px solid #d5dfe5;
        background: #fff;
        color: #526672;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        padding: 0 13px;
      }
      .btn-primary-mahindra {
        height: 36px;
        background: var(--red);
        border: 1px solid var(--red);
        color: #fff;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 800;
        padding: 0 15px;
      }
      .btn-primary-mahindra:hover {
        background: #8f1234;
        color: #fff;
      }

      .tabs {
        display: flex;
        gap: 24px;
        border-bottom: 1px solid #d9e1e6;
        margin-bottom: 15px;
      }
      .tabs a {
        padding: 9px 2px 10px;
        color: #617481;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        position: relative;
      }
      .tabs a.active {
        color: var(--red);
      }
      .tabs a.active:after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: var(--red);
      }

      .filter-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 9px #071b2d0c;
        padding: 15px 17px 16px;
        margin-bottom: 14px;
      }
      .filter-grid {
        display: grid;
        grid-template-columns: 1.35fr 1fr 1fr 1.25fr 1fr auto;
        gap: 11px;
        align-items: end;
      }
      .filter-label {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 800;
        color: #687a87;
        margin-bottom: 5px;
      }
      .filter-control {
        height: 37px;
        border: 1px solid #d5dfe6;
        border-radius: 6px;
        font-size: 11px;
        color: #415563;
        background: #fff;
      }
      .filter-control:focus {
        border-color: #bb7088;
        box-shadow: 0 0 0 3px rgba(169, 21, 61, 0.07);
      }
      .filter-actions {
        display: flex;
        gap: 7px;
      }
      .apply {
        height: 37px;
        background: var(--red);
        color: #fff;
        border: 1px solid var(--red);
        font-size: 10px;
        font-weight: 800;
        padding: 0 16px;
        border-radius: 6px;
      }
      .clear {
        height: 37px;
        border: 1px solid #d5dfe6;
        background: #fff;
        color: #657682;
        border-radius: 6px;
        width: 38px;
      }

      .table-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 9px #071b2d0c;
        overflow: hidden;
      }
      .table-head {
        padding: 15px 17px 11px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .table-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--navy);
      }
      .table-meta {
        font-size: 10px;
        color: #7a8994;
        margin-top: 3px;
      }
      .table-tools {
        display: flex;
        gap: 7px;
      }
      .tool-btn {
        height: 32px;
        border: 1px solid #d7e0e5;
        background: #fff;
        border-radius: 6px;
        color: #617481;
        font-size: 10px;
        padding: 0 11px;
        font-weight: 700;
      }
      .table-wrap {
        overflow: auto;
        border-top: 1px solid #e2e8ec;
      }
      .records-table {
        width: 100%;
        min-width: 1550px;
        border-collapse: separate;
        border-spacing: 0;
      }
      .records-table th {
        background: #f5f7f9;
        color: #627582;
        border-right: 1px solid #edf1f4;
        border-bottom: 1px solid #dce4e9;
        padding: 10px 9px;
        font-size: 8px;
        line-height: 1.25;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        white-space: nowrap;
      }
      .records-table td {
        padding: 10px 9px;
        color: #405463;
        border-right: 1px solid #f0f3f5;
        border-bottom: 1px solid #e8edf0;
        font-size: 10px;
        white-space: nowrap;
      }
      .records-table tbody tr:hover td {
        background: #fbfcfd;
      }
      .records-table th:first-child,
      .records-table td:first-child {
        padding-left: 16px;
      }
      .doc-link {
        color: #3e6e96;
        font-weight: 800;
      }
      .project-name {
        font-weight: 700;
        color: #344e60;
      }
      .material-code,
      .customer-code {
        font-weight: 700;
        color: #556c7a;
      }
      .status {
        display: inline-flex;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 8px;
        font-weight: 800;
      }
      .pending {
        background: #f8e9ee;
        color: #95506a;
      }
      .approved {
        background: #e7f3ec;
        color: #477463;
      }
      .progress {
        background: #e9f0f6;
        color: #4e718d;
      }
      .completed {
        background: #e5f2ec;
        color: #3e725f;
      }
      .action-group {
        display: flex;
        gap: 4px;
      }
      .action {
        width: 27px;
        height: 25px;
        border: 1px solid #e0e6ea;
        background: #fff;
        color: #71818d;
        border-radius: 5px;
        display: grid;
        place-items: center;
      }
      .action:hover {
        background: #f6eaf0;
        color: var(--red);
        border-color: #e2ccd5;
      }
      .table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 11px 17px;
        color: #7a8994;
        font-size: 10px;
      }
      .page-size {
        display: flex;
        align-items: center;
        gap: 7px;
      }
      .page-size select {
        height: 29px;
        border: 1px solid #d9e2e7;
        border-radius: 5px;
        font-size: 10px;
        padding: 0 8px;
      }
      .pagination .page-link {
        font-size: 10px;
        color: #617481;
        border-color: #e0e6ea;
      }
      .pagination .active .page-link {
        background: var(--red);
        border-color: var(--red);
        color: #fff;
      }
      /* Status badge and remark tooltip */
      .status {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 14px;
        font-size: 9px;
        font-weight: 800;
        cursor: help;
        border: 1px solid transparent;
      }
      .status.pending {
        background: #fff3d9;
        color: #8a6415;
        border-color: #f0dfb7;
      }
      .status.progress {
        background: #e8f1fa;
        color: #35648d;
        border-color: #cbddec;
      }
      .status.completed {
        background: #e6f3eb;
        color: #347052;
        border-color: #cbe4d5;
      }
      .status.rejected {
        background: #fbe9e9;
        color: #a73535;
        border-color: #efcccc;
      }
      /* Edit status modal */
      .status-modal .modal-content {
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 15px 45px #071b2d26;
      }
      .status-modal .modal-header {
        background: #f8fafb;
        border-bottom: 1px solid var(--border);
        padding: 17px 20px;
      }
      .status-modal .modal-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--navy);
      }
      .status-modal .modal-body {
        padding: 22px 20px;
      }
      .status-modal .form-label {
        font-size: 11px;
        font-weight: 800;
        color: #536777;
        margin-bottom: 9px;
      }
      .status-options {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
      }
      .status-option {
        position: relative;
      }
      .status-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }
      .status-option label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 13px;
        border: 1px solid #dce4e9;
        border-radius: 20px;
        background: #fff;
        color: #536777;
        cursor: pointer;
        font-size: 11px;
        font-weight: 700;
        transition: all 0.15s ease;
      }
      .status-option label:hover {
        background: #f5f7f9;
      }
      .status-option input:checked + label {
        border-color: var(--red);
        background: var(--red-soft);
        color: var(--red);
        box-shadow: 0 0 0 2px #a9153d12;
      }
      .status-option input:focus-visible + label {
        outline: 2px solid var(--red);
        outline-offset: 3px;
      }
      .status-modal textarea {
        min-height: 110px;
        resize: vertical;
        font-size: 12px;
        border-color: #d5dfe6;
      }
      .status-modal textarea:focus {
        border-color: #bb7088;
        box-shadow: 0 0 0 3px #a9153d12;
      }
      .status-modal .modal-footer {
        padding: 13px 20px;
        border-top: 1px solid var(--border);
      }
      .edit-record-btn {
        color: var(--red);
      }
      .edit-record-btn:hover {
        background: var(--red-soft);
        border-color: #e2ccd5;
      }
      /* Program progress modal */
      .progress-modal .modal-content {
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 15px 45px #071b2d26;
        overflow: hidden;
      }
      .progress-modal .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        border-left: 4px solid var(--red);
      }
      .progress-modal .modal-title {
        font-size: 17px;
        font-weight: 800;
        color: var(--navy);
      }
      .progress-record-details {
        margin-top: 7px;
        font-size: 10px;
        color: #627582;
        line-height: 1.8;
      }
      .review-indicator {
        display: inline-block;
        margin-top: 5px;
        padding: 4px 9px;
        border-radius: 12px;
        background: #fff3d9;
        color: #8a6415;
        font-size: 9px;
        font-weight: 800;
      }
      .progress-modal .modal-body {
        padding: 30px 24px 22px;
      }
      .progress-track-scroll {
        width: 100%;
        overflow-x: auto;
        padding: 5px 4px 14px;
        scrollbar-width: thin;
        scrollbar-color: #c3cdd4 #f1f4f6;
      }
      .progress-track {
        display: flex;
        align-items: flex-start;
        min-width: 850px;
        padding-top: 4px;
      }
      .progress-stage {
        flex: 1;
        min-width: 0;
        position: relative;
        text-align: center;
      }
      .progress-stage:not(:last-child)::after {
        content: "";
        position: absolute;
        top: 12px;
        left: calc(50% + 13px);
        width: calc(100% - 26px);
        height: 2px;
        background: #dce4e9;
        z-index: 0;
      }
      .progress-stage.done:not(:last-child)::after {
        background: var(--red);
      }
      .progress-stage-circle {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 25px;
        height: 25px;
        margin: 0 auto 9px;
        border: 2px solid #dce4e9;
        border-radius: 50%;
        background: white;
        color: #71818d;
        font-size: 10px;
        font-weight: 800;
      }
      .progress-stage.done .progress-stage-circle {
        background: var(--red);
        border-color: var(--red);
        color: white;
      }
      .progress-stage.current .progress-stage-circle {
        background: #f7e9ee;
        border-color: var(--red);
        color: var(--red);
        box-shadow: 0 0 0 4px #a9153d12;
      }
      .progress-stage-name {
        padding: 0 3px;
        color: #687a87;
        font-size: 9px;
        line-height: 1.4;
        overflow-wrap: anywhere;
      }
      .progress-stage.done .progress-stage-name,
      .progress-stage.current .progress-stage-name {
        color: var(--navy);
        font-weight: 800;
      }
      .progress-stage-state {
        margin-top: 4px;
        color: #85939d;
        font-size: 8px;
      }
      .progress-stage.current .progress-stage-state {
        color: var(--red);
        font-weight: 800;
      }
      .progress-legend {
        display: flex;
        justify-content: center;
        gap: 22px;
        flex-wrap: wrap;
        margin-top: 12px;
        color: #71818d;
        font-size: 9px;
      }
      .legend-dot {
        display: inline-block;
        width: 9px;
        height: 9px;
        margin-right: 5px;
        border-radius: 50%;
        vertical-align: middle;
      }
      .legend-done {
        background: var(--red);
      }
      .legend-current {
        background: #f7e9ee;
        border: 2px solid var(--red);
      }
      .legend-upcoming {
        background: white;
        border: 1px solid #cbd5dc;
      }
      @media (max-width: 700px) {
        .progress-modal .modal-header {
          align-items: flex-start;
          flex-direction: column;
          padding: 16px;
        }
        .progress-header-actions {
          justify-content: flex-start;
        }
        .progress-modal .modal-body {
          padding: 20px 14px;
        }
      }
      @media (max-width: 1100px) {
        .filter-grid {
          grid-template-columns: 1fr 1fr 1fr;
        }
        .filter-actions {
          grid-column: 1/-1;
        }
      }
      @media (max-width: 700px) {
        .top-menu {
          display: none;
        }
        .page {
          padding: 18px 14px;
        }
        .page-title-row {
          flex-direction: column;
          gap: 12px;
        }
        .filter-grid {
          grid-template-columns: 1fr;
        }
        .filter-actions {
          grid-column: auto;
        }
        .profile-name {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container-fluid px-4">
        <div
          class="header-inner d-flex align-items-center justify-content-between gap-3"
        >
          <a class="mahindra-logo" href="#"
            ><img src="mahindra_rise_red.png" alt="Mahindra"
          /></a>
          <nav class="top-menu">
            <a href="mahindra_engineering_dashboard.html"
              ><i class="bi bi-grid-1x2 me-1"></i>Dashboard</a
            >
            <a href="mahindra_engineering_input_bd.html" class="active"
              ><i class="bi bi-folder2-open me-1"></i>Input BD</a
            >
            <a href="mahindra_programs.html"
              ><i class="bi bi-folder2-open me-1"></i>Mahindra Programs</a
            >
            <a href="mahindra_engineering_records.html"
              ><i class="bi bi-folder2-open me-1"></i>Engineering 1</a
            >
            <a href="mahindra_engineering_records_new.html"
              ><i class="bi bi-folder2-open me-1"></i>Engineering 2</a
            >
            <a href="#"><i class="bi bi-bar-chart-line me-1"></i>Reports</a>
          </nav>
          <div class="dropdown">
            <button
              class="profile-btn dropdown-toggle"
              data-bs-toggle="dropdown"
            >
              <div>
                <div class="profile-name">Priyank Jain</div>
                <div class="profile-role">Engineering User</div>
              </div>
              <span class="avatar">PJ</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end mt-2">
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-person me-2"></i>My Profile</a
                >
              </li>
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-gear me-2"></i>Settings</a
                >
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item text-danger" href="#"
                  ><i class="bi bi-box-arrow-right me-2"></i>Logout</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </header>

    <main class="page">
      <div class="breadcrumb">
        <span>Home</span> <i class="bi bi-chevron-right mx-1"></i>
        <strong>Input BD Records</strong>
      </div>

      <div class="page-title-row">
        <div>
          <h1 class="page-title">Input BD Records</h1>
          <div class="page-subtitle">
            Search, review and manage Input BD document submissions and project
            material information.
          </div>
          <div class="title-accent"></div>
        </div>
        <div class="header-actions">
          <button class="btn-light-action">
            <i class="bi bi-download me-1"></i>Download Template
          </button>
          <button class="btn-light-action">
            <i class="bi bi-upload me-1"></i>Upload Excel
          </button>
          <button class="btn-primary-mahindra">
            <i class="bi bi-plus-lg me-1"></i>New Record
          </button>
        </div>
      </div>

      <div class="tabs">
        <a href="#" class="active">All Records</a>
        <a href="#">Pending Review</a>
        <a href="#">Approved</a>
        <a href="#">In Progress</a>
        <a href="#">Completed</a>
      </div>

      <section class="filter-card">
        <div class="filter-grid">
          <div>
            <div class="filter-label">Doc No.</div>
            <input
              id="docNo"
              class="form-control filter-control"
              placeholder="Search document number"
            />
          </div>
          <div>
            <div class="filter-label">Customer Code</div>
            <input
              id="customer"
              class="form-control filter-control"
              placeholder="Search customer code"
            />
          </div>
          <div>
            <div class="filter-label">Project Name</div>
            <input
              id="project"
              class="form-control filter-control"
              placeholder="Search project name"
            />
          </div>
          <div>
            <div class="filter-label">Customer Material Code</div>
            <input
              id="material"
              class="form-control filter-control"
              placeholder="Search material code"
            />
          </div>
          <div>
            <div class="filter-label">Status</div>
            <select id="status" class="form-select filter-control">
              <option value="">All</option>
              <option value="Pending">Pending Program Review</option>
              <option value="In Progress">In Progress</option>
              <option value="Complete">Completed</option>
              <option value="Rejected">Rejected</option>
            </select>
          </div>
          <div class="filter-actions">
            <button class="apply" onclick="applyFilters()">
              <i class="bi bi-funnel me-1"></i>Apply</button
            ><button class="clear" onclick="clearFilters()" title="Clear">
