        const csv = [
            csvHeaders.map(esc).join(","),
            ...data.map((r) => r.map(esc).join(",")),
          ].join("\r\n"),
          url = URL.createObjectURL(
            new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" }),
          ),
          a = document.createElement("a");
        a.href = url;
        a.download = "input-bd-records.csv";
        a.click();
        URL.revokeObjectURL(url);
      }
      function uploadExcel(event) {
        const file = event.target.files?.[0];
        if (!file) return;
        if (typeof XLSX === "undefined") {
          alert("Excel reader failed to load. Check your internet connection.");
          event.target.value = "";
          return;
        }
        const reader = new FileReader();
        reader.onload = (e) => {
          try {
            const wb = XLSX.read(e.target.result, { type: "array" }),
              sheet = wb.Sheets[wb.SheetNames[0]],
              rows = XLSX.utils.sheet_to_json(sheet, {
                header: 1,
                defval: "",
                raw: false,
              }),
              data = rows
                .slice(1)
                .filter((r) => r.some((v) => String(v).trim()));
            if (!data.length) {
              alert(
                "No data rows found. The first row should contain headings.",
              );
              return;
            }
            if (!confirm(`Add ${data.length} row(s) from ${file.name}?`))
              return;
            data.forEach((row) => {
              const r = Array.from({ length: 15 }, (_, i) =>
                String(row[i] ?? "").trim(),
              );
              if (!r[14]) r[14] = "Pending Program Review";
              if (row[15] !== undefined) r[15] = String(row[15]).trim();
              records.push(r);
            });
            currentPage = 1;
            render();
            alert(`Imported ${data.length} row(s).`);
          } catch (err) {
            console.error(err);
            alert(
              "Could not read the file. Please select a valid Excel or CSV file.",
            );
          } finally {
            event.target.value = "";
          }
        };
        reader.onerror = () => {
          alert("Unable to read this file.");
          event.target.value = "";
        };
        reader.readAsArrayBuffer(file);
      }
