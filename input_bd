          })
          .join("");
        document.getElementById("recordCount").textContent = rows.length;
        document.getElementById("total").textContent = rows.length;
        document.getElementById("showing").textContent = rows.length
          ? `1 to ${rows.length}`
          : "0";
      }
      /* =========================================================
  EDIT STATUS MODAL
  ========================================================= */
      const editStatusModal = new bootstrap.Modal(
        document.getElementById("editStatusModal"),
      );
      // Convert DD-MM-YYYY into YYYY-MM-DD for the date picker.
      function dateToInput(dateString) {
        if (!dateString) return "";
        const parts = dateString.split("-");
        if (parts.length !== 3) return "";
        const [day, month, year] = parts;
        return `${year}-${month.padStart(2, "0")}-${day.padStart(2, "0")}`;
      }
      // Convert YYYY-MM-DD back to DD-MM-YYYY for the table.
      function inputToDisplay(dateString) {
        if (!dateString) return "";
        const [year, month, day] = dateString.split("-");
        return `${day}-${month}-${year}`;
      }
      function editRecord(index) {
        const record = records[index];
        if (!record) return;
        document.getElementById("editingRecordIndex").value = index;
        document.getElementById("editRecordNumber").textContent =
          `${record[1]} • ${record[6]}`;
        const currentStatus = normalizeStatus(record[14]);
        const statusRadio = document.querySelector(
          `input[name="recordStatus"][value="${currentStatus}"]`,
        );
        document
          .querySelectorAll('input[name="recordStatus"]')
          .forEach((radio) => {
            radio.checked = false;
          });
        if (statusRadio) {
          statusRadio.checked = true;
        } else {
          document.getElementById("statusPending").checked = true;
        }
        document.getElementById("statusRemark").value = record[15] || "";
        document.getElementById("plannedSubmissionDate").value = dateToInput(
          record[13],
        );
        editStatusModal.show();
      }
      /* Save the selected status and remark */
      document
        .getElementById("editStatusForm")
        .addEventListener("submit", function (event) {
          event.preventDefault();
          const index = Number(
            document.getElementById("editingRecordIndex").value,
          );
          const record = records[index];
          if (!record) return;
          const selected = document.querySelector(
            'input[name="recordStatus"]:checked',
          );
          if (!selected) return;
          // Status is stored in column 15 (index 14).
          record[14] = selected.value;
          // Remark is stored in the new column 16 (index 15).
          record[15] = document.getElementById("statusRemark").value.trim();
          const selectedDate = document.getElementById(
            "plannedSubmissionDate",
          ).value;

          record[13] = inputToDisplay(selectedDate);
          editStatusModal.hide();
          // Refresh the badge, tooltip, filters, and record counters.
          render();
        });
      /* Basic view action */
      function viewRecord(index) {
        const record = records[index];
        if (!record) return;
        editRecord(index);
      }

      // Workflow stages displayed in the progress modal.
      const programStages = [
        "BD",
        "Program",
        "Configuration",
        "Engineering",
        "Tooling",
        "SCM",
        "PPC",
        "Production",
        "Quality",
        "FAI Submission",
      ];
      // Keep the current stage for each record separately.
      // Default stage 2 matches the screenshot's Program / In Review state.
      const progressByRecord = {};
      let activeProgressIndex = null;
      const programProgressModal = bootstrap.Modal.getOrCreateInstance(
        document.getElementById("programProgressModal"),
      );
      function getProgressStage(index) {
        if (progressByRecord[index] === undefined) {
          progressByRecord[index] = 2;
        }
        return progressByRecord[index];
      }
      function openProgressModal(index) {
        const record = records[index];
        if (!record) return;
        activeProgressIndex = index;
        document.getElementById("progressRecordDetails").innerHTML =
          `<strong>Doc Ref No.:</strong> ${escapeHTML(record[1])}` +
          ` &nbsp; | &nbsp; <strong>Customer:</strong> ${escapeHTML(record[5])}` +
          ` &nbsp; | &nbsp; <strong>Material Code:</strong> ${escapeHTML(record[6])}`;
        renderProgramProgress(index);
        programProgressModal.show();
      }
      function renderProgramProgress(index) {
        const currentStage = getProgressStage(index);
        const stageContainer = document.getElementById("programProgressTrack");
        stageContainer.innerHTML = programStages
          .map((stage, i) => {
            const stageNumber = i + 1;
            const isDone = stageNumber < currentStage;
            const isCurrent = stageNumber === currentStage;
            const stateClass = isDone
              ? "done"
              : isCurrent
                ? "current"
                : "upcoming";
            const stateLabel = isDone
              ? "Completed"
              : isCurrent
                ? "In Review"
                : "Upcoming";
            return `
<div class="progress-stage ${stateClass}">
<div class="progress-stage-circle">
           ${isDone ? '<i class="bi bi-check2"></i>' : stageNumber}
</div>
<div class="progress-stage-name">
           ${escapeHTML(stage)}
</div>
<div class="progress-stage-state">
           ${stateLabel}
</div>
</div>
     `;
          })
          .join("");
        const statusText =
          currentStage === programStages.length
            ? "FAI Submission"
            : "In Review — " + programStages[currentStage - 1];
        document.getElementById("progressReviewStatus").textContent =
          statusText;
        // Do not allow approval beyond the final stage.
        const approveButton = document.querySelector(
          "#programProgressModal .approve-action",
        );
        approveButton.disabled = currentStage === programStages.length;
      }
      function approveProgress() {
        if (activeProgressIndex === null) return;
        const currentStage = getProgressStage(activeProgressIndex);
        if (currentStage < programStages.length) {
          progressByRecord[activeProgressIndex] = currentStage + 1;
          renderProgramProgress(activeProgressIndex);
        }
      }
      function sendBackProgress() {
        if (activeProgressIndex === null) return;
        const currentStage = getProgressStage(activeProgressIndex);
        if (currentStage > 1) {
          progressByRecord[activeProgressIndex] = currentStage - 1;
          renderProgramProgress(activeProgressIndex);
        }
      }
      function editProgressRecord() {
        if (activeProgressIndex === null) return;
        const index = activeProgressIndex;
        // Open the existing status and remarks modal after this modal closes.
        document
          .getElementById("programProgressModal")
          .addEventListener("hidden.bs.modal", function openEditAfterClose() {
            this.removeEventListener("hidden.bs.modal", openEditAfterClose);
            editRecord(index);
          });
        programProgressModal.hide();
      }

      function applyFilters() {
        render();
      }
      function clearFilters() {
        ["docNo", "customer", "project", "material"].forEach((id) => {
          document.getElementById(id).value = "";
        });
        document.getElementById("status").value = "";
        render();
      }

      function exportCSV() {
        const headers = [
          "Sr No",
          "Doc Type",
          "Doc No",
          "Doc Date",
          "Version",
          "Customer Code",
          "Project Name",
          "Material Code",
          "RC Price",
          "NRC Price",
          "NRC Qty",
          "Currency",
          "Valid From",
          "Valid To",
          "Planned Submission",
          "Status",
          "Remarks",
        ];
        const escapeCSV = (value) =>
          `"${String(value ?? "").replace(/"/g, '""')}"`;
        const csv = [
          headers.map(escapeCSV).join(","),
          ...records.map((record, i) =>
            [i + 1, ...record].map(escapeCSV).join(","),
          ),
        ].join("\r\n");
        const link = document.createElement("a");
        link.href = URL.createObjectURL(
          new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" }),
        );
        link.download = "input-bd-records.csv";
        link.click();
        URL.revokeObjectURL(link.href);
      }
      render();
    </script>
