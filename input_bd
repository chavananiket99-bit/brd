      function normalizeStatus(s) {
        if (s === "Pending Program Review") return "Pending";
        if (["Completed", "Approved", "Complete"].includes(s))
          return "Complete";
        return s || "Pending";
      }
      function statusClass(s) {
        s = normalizeStatus(s);
        return s === "In Progress"
          ? "inprogress"
          : s === "Complete"
            ? "completed"
            : s === "Rejected"
              ? "rejected"
              : "pending";
      }
      function getFilteredRows() {
        const d = docNo.value.trim().toLowerCase(),
          c = customer.value.trim().toLowerCase(),
          p = project.value.trim().toLowerCase(),
          m = material.value.trim().toLowerCase(),
          s = status.value,
          q = globalSearch.value.trim().toLowerCase();
        let out = records
          .map((record, originalIndex) => ({ record, originalIndex }))
          .filter(
            ({ record: r }) =>
              (!q ||
                r.some((v) =>
                  String(v ?? "")
                    .toLowerCase()
                    .includes(q),
                )) &&
              (!d || String(r[1]).toLowerCase().includes(d)) &&
              (!c || String(r[4]).toLowerCase().includes(c)) &&
              (!p || String(r[5]).toLowerCase().includes(p)) &&
              (!m || String(r[6]).toLowerCase().includes(m)) &&
              (!s || normalizeStatus(r[14]) === s),
          );
        if (sortColumn >= 1 && sortColumn <= 15) {
          const ix = sortColumn - 1;
          out.sort((a, b) => {
            let x = String(a.record[ix] ?? ""),
              y = String(b.record[ix] ?? ""),
              nx = Number(x),
              ny = Number(y);
            let z =
              x.trim() && y.trim() && Number.isFinite(nx) && Number.isFinite(ny)
                ? nx - ny
                : x.localeCompare(y, undefined, {
                    numeric: true,
                    sensitivity: "base",
                  });
            return sortDirection === "asc" ? z : -z;
          });
        }
        return out;
      }
