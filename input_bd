      function renderPagination(pages) {
        const el = document.getElementById("pagination"),
          item = (p, label, disabled = false, active = false) =>
            `<li class="page-item ${disabled ? "disabled" : ""} ${active ? "active" : ""}"><button type="button" class="page-link" ${disabled ? "disabled" : ""} onclick="goToPage(${p})">${label}</button></li>`;
        let h = item(currentPage - 1, "‹", currentPage === 1),
          lo = Math.max(1, currentPage - 2),
          hi = Math.min(pages, currentPage + 2);
        if (lo > 1) {
          h += item(1, "1", false, currentPage === 1);
          if (lo > 2)
            h +=
              '<li class="page-item disabled"><span class="page-link">…</span></li>';
        }
        for (let p = lo; p <= hi; p++)
          h += item(p, p, false, p === currentPage);
        if (hi < pages) {
          if (hi < pages - 1)
            h +=
              '<li class="page-item disabled"><span class="page-link">…</span></li>';
          h += item(pages, pages, false, currentPage === pages);
        }
        h += item(currentPage + 1, "›", currentPage === pages);
        el.innerHTML = h;
      }
