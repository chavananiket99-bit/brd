<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mahindra Engineering Records</title>
    <link
      rel="stylesheet"
      href="https://fontsstorage.blob.core.windows.net/html/css/georama.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <style>
      :root {
        --red: #a9153d;
        --red-soft: #f7e9ee;
        --navy: #071b2d;
        --ink: #243746;
        --muted: #71818d;
        --bg: #f3f6f8;
        --surface: #fff;
        --border: #dce4e9;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Georama-Regular", Arial, sans-serif;
        font-size: 12px;
      }
      .topbar {
        height: 68px;
        background: #fff;
        border-bottom: 2px solid #a9153d;
        box-shadow: 0 1px 5px rgba(7, 27, 45, 0.06);
      }
      .header-inner {
        height: 68px;
      }
      .mahindra-logo img {
        width: 170px;
        height: auto;
      }
      .top-menu {
        display: flex;
        gap: 4px;
        align-items: center;
      }
      .top-menu a {
        color: #465967;
        text-decoration: none;
        padding: 11px 16px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
      }
      .top-menu a:hover,
      .top-menu a.active {
        background: #f5eaf0;
        color: var(--red);
      }
      .top-menu a.active {
        box-shadow: inset 0 -2px 0 var(--red);
      }
      .profile-btn {
        border: 0;
        background: transparent;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 5px 7px;
      }
      .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #a9153d;
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 800;
        font-size: 11px;
      }
      .profile-name {
        font-size: 11px;
        font-weight: 800;
        text-align: left;
      }
      .profile-role {
        font-size: 9px;
        color: #7b8993;
      }
      .dropdown-menu {
        border: 1px solid var(--border);
        box-shadow: 0 8px 24px #071b2d22;
        border-radius: 8px;
      }
      .dropdown-item {
        font-size: 12px;
        padding: 9px 14px;
      }

      .page {
        padding: 24px 28px 40px;
        max-width: 1500px;
        margin: auto;
      }
      .breadcrumb {
        font-size: 10px;
        color: #82909a;
        margin-bottom: 7px;
      }
      .breadcrumb strong {
        color: #4e6270;
      }
      .page-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
      }
      .page-title {
        font-size: 23px;
        font-weight: 800;
        color: var(--navy);
        margin: 0;
      }
      .page-subtitle {
        font-size: 11px;
        color: #71818d;
        margin-top: 5px;
      }
      .title-accent {
        height: 3px;
        width: 45px;
        background: var(--red);
        border-radius: 3px;
        margin-top: 9px;
      }
      .header-actions {
        display: flex;
        gap: 8px;
      }
      .btn-light-action {
        height: 36px;
        border: 1px solid #d5dfe5;
        background: #fff;
        color: #526672;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        padding: 0 13px;
      }
      .btn-primary-mahindra {
        height: 36px;
        background: var(--red);
        border: 1px solid var(--red);
        color: #fff;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 800;
        padding: 0 15px;
      }
      .btn-primary-mahindra:hover {
        background: #8f1234;
        color: #fff;
      }

      .tabs {
        display: flex;
        gap: 24px;
        border-bottom: 1px solid #d9e1e6;
        margin-bottom: 15px;
      }
      .tabs a {
        padding: 9px 2px 10px;
        color: #617481;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        position: relative;
      }
      .tabs a.active {
        color: var(--red);
      }
      .tabs a.active:after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: var(--red);
      }

      .filter-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 9px #071b2d0c;
        padding: 15px 17px 16px;
        margin-bottom: 14px;
      }
      .filter-grid {
        display: grid;
        grid-template-columns: 1.35fr 1fr 1fr 1.25fr 1fr auto;
        gap: 11px;
        align-items: end;
      }
      .filter-label {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 800;
        color: #687a87;
        margin-bottom: 5px;
      }
      .filter-control {
        height: 37px;
        border: 1px solid #d5dfe6;
        border-radius: 6px;
        font-size: 11px;
        color: #415563;
        background: #fff;
      }
      .filter-control:focus {
        border-color: #bb7088;
        box-shadow: 0 0 0 3px rgba(169, 21, 61, 0.07);
      }
      .filter-actions {
        display: flex;
        gap: 7px;
      }
      .apply {
        height: 37px;
        background: var(--red);
        color: #fff;
        border: 1px solid var(--red);
        font-size: 10px;
        font-weight: 800;
        padding: 0 16px;
        border-radius: 6px;
      }
      .clear {
        height: 37px;
        border: 1px solid #d5dfe6;
        background: #fff;
        color: #657682;
        border-radius: 6px;
        width: 38px;
      }

      .table-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 2px 9px #071b2d0c;
        overflow: hidden;
      }
      .table-head {
        padding: 15px 17px 11px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .table-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--navy);
      }
      .table-meta {
        font-size: 10px;
        color: #7a8994;
        margin-top: 3px;
      }
      .table-tools {
        display: flex;
        gap: 7px;
      }
      .tool-btn {
        height: 32px;
        border: 1px solid #d7e0e5;
        background: #fff;
        border-radius: 6px;
        color: #617481;
        font-size: 10px;
        padding: 0 11px;
        font-weight: 700;
      }
      .table-wrap {
        overflow: auto;
        border-top: 1px solid #e2e8ec;
      }
      .records-table {
        width: 100%;
        min-width: 1550px;
        border-collapse: separate;
        border-spacing: 0;
      }
      .records-table th {
        background: #f5f7f9;
        color: #627582;
        border-right: 1px solid #edf1f4;
        border-bottom: 1px solid #dce4e9;
        padding: 10px 9px;
        font-size: 8px;
        line-height: 1.25;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        white-space: nowrap;
      }
      .records-table td {
        padding: 10px 9px;
        color: #405463;
        border-right: 1px solid #f0f3f5;
        border-bottom: 1px solid #e8edf0;
        font-size: 10px;
        white-space: nowrap;
      }
      .records-table tbody tr:hover td {
        background: #fbfcfd;
      }
      .records-table th:first-child,
      .records-table td:first-child {
        padding-left: 16px;
      }
      .doc-link {
        color: #3e6e96;
        font-weight: 800;
      }
      .project-name {
        font-weight: 700;
        color: #344e60;
      }
      .material-code,
      .customer-code {
        font-weight: 700;
        color: #556c7a;
      }
      .status {
        display: inline-flex;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 8px;
        font-weight: 800;
      }
      .pending {
        background: #f8e9ee;
        color: #95506a;
      }
      .approved {
        background: #e7f3ec;
        color: #477463;
      }
      .progress {
        background: #e9f0f6;
        color: #4e718d;
      }
      .completed {
        background: #e5f2ec;
        color: #3e725f;
      }
      .action-group {
        display: flex;
        gap: 4px;
      }
      .action {
        width: 27px;
        height: 25px;
        border: 1px solid #e0e6ea;
        background: #fff;
        color: #71818d;
        border-radius: 5px;
        display: grid;
        place-items: center;
      }
      .action:hover {
        background: #f6eaf0;
        color: var(--red);
        border-color: #e2ccd5;
      }
      .table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 11px 17px;
        color: #7a8994;
        font-size: 10px;
      }
      .page-size {
        display: flex;
        align-items: center;
        gap: 7px;
      }
      .page-size select {
        height: 29px;
        border: 1px solid #d9e2e7;
        border-radius: 5px;
        font-size: 10px;
        padding: 0 8px;
      }
      .pagination .page-link {
        font-size: 10px;
        color: #617481;
        border-color: #e0e6ea;
      }
      .pagination .active .page-link {
        background: var(--red);
        border-color: var(--red);
        color: #fff;
      }
      @media (max-width: 1100px) {
        .filter-grid {
          grid-template-columns: 1fr 1fr 1fr;
        }
        .filter-actions {
          grid-column: 1/-1;
        }
      }
      @media (max-width: 700px) {
        .top-menu {
          display: none;
        }
        .page {
          padding: 18px 14px;
        }
        .page-title-row {
          flex-direction: column;
          gap: 12px;
        }
        .filter-grid {
          grid-template-columns: 1fr;
        }
        .filter-actions {
          grid-column: auto;
        }
        .profile-name {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container-fluid px-4">
        <div
          class="header-inner d-flex align-items-center justify-content-between gap-3"
        >
          <a class="mahindra-logo" href="#"
            ><img src="mahindra_rise_red.png" alt="Mahindra"
          /></a>
          <nav class="top-menu">
            <a href="mahindra_engineering_dashboard.html"
              ><i class="bi bi-grid-1x2 me-1"></i>Dashboard</a
            >
            <a href="mahindra_engineering_input_bd.html" class="active"
              ><i class="bi bi-folder2-open me-1"></i>Input BD</a
            >
            <a href="mahindra_engineering_records.html"
              ><i class="bi bi-folder2-open me-1"></i>Engineering 1</a
            >
            <a href="mahindra_engineering_records_new.html"
              ><i class="bi bi-folder2-open me-1"></i>Engineering 2</a
            >
            <a href="#"><i class="bi bi-bar-chart-line me-1"></i>Reports</a>
          </nav>
          <div class="dropdown">
            <button
              class="profile-btn dropdown-toggle"
              data-bs-toggle="dropdown"
            >
              <div>
                <div class="profile-name">Priyank Jain</div>
                <div class="profile-role">Engineering User</div>
              </div>
              <span class="avatar">PJ</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end mt-2">
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-person me-2"></i>My Profile</a
                >
              </li>
              <li>
                <a class="dropdown-item" href="#"
                  ><i class="bi bi-gear me-2"></i>Settings</a
                >
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item text-danger" href="#"
                  ><i class="bi bi-box-arrow-right me-2"></i>Logout</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </header>

    <main class="page">
      <div class="breadcrumb">
        <span>Home</span> <i class="bi bi-chevron-right mx-1"></i>
        <strong>Input BD Records</strong>
      </div>

      <div class="page-title-row">
        <div>
          <h1 class="page-title">Input BD Records</h1>
          <div class="page-subtitle">
            Search, review and manage Input BD document submissions and project
            material information.
          </div>
          <div class="title-accent"></div>
        </div>
        <div class="header-actions">
          <button class="btn-light-action">
            <i class="bi bi-download me-1"></i>Download Template
          </button>
          <button class="btn-light-action">
            <i class="bi bi-upload me-1"></i>Upload Excel
          </button>
          <button class="btn-primary-mahindra">
            <i class="bi bi-plus-lg me-1"></i>New Record
          </button>
        </div>
      </div>

      <div class="tabs">
        <a href="#" class="active">All Records</a>
        <a href="#">Pending Review</a>
        <a href="#">Approved</a>
        <a href="#">In Progress</a>
        <a href="#">Completed</a>
      </div>

      <section class="filter-card">
        <div class="filter-grid">
          <div>
            <div class="filter-label">Doc No.</div>
            <input
              id="docNo"
              class="form-control filter-control"
              placeholder="Search document number"
            />
          </div>
          <div>
            <div class="filter-label">Customer Code</div>
            <input
              id="customer"
              class="form-control filter-control"
              placeholder="Search customer code"
            />
          </div>
          <div>
            <div class="filter-label">Project Name</div>
            <input
              id="project"
              class="form-control filter-control"
              placeholder="Search project name"
            />
          </div>
          <div>
            <div class="filter-label">Customer Material Code</div>
            <input
              id="material"
              class="form-control filter-control"
              placeholder="Search material code"
            />
          </div>
          <div>
            <div class="filter-label">Status</div>
            <select id="status" class="form-select filter-control">
              <option value="">All</option>
              <option>Pending Program Review</option>
              <option>Approved</option>
              <option>In Progress</option>
              <option>Completed</option>
            </select>
          </div>
          <div class="filter-actions">
            <button class="apply" onclick="applyFilters()">
              <i class="bi bi-funnel me-1"></i>Apply</button
            ><button class="clear" onclick="clearFilters()" title="Clear">
              <i class="bi bi-arrow-counterclockwise"></i>
            </button>
          </div>
        </div>
      </section>

      <section class="table-card">
        <div class="table-head">
          <div>
            <div class="table-title">
              Engineering Records
              <span class="table-meta">(<span id="recordCount">10</span>)</span>
            </div>
            <div class="table-meta">
              Document and material details captured from the engineering input
              data.
            </div>
          </div>
          <div class="table-tools">
            <button class="tool-btn" onclick="exportCSV()">
              <i class="bi bi-download me-1"></i>Export</button
            ><button class="tool-btn">
              <i class="bi bi-layout-three-columns me-1"></i>Columns
              <i class="bi bi-chevron-down ms-1"></i>
            </button>
          </div>
        </div>
        <div class="table-wrap">
          <table class="records-table">
            <thead>
              <tr>
                <th>Sr. No.</th>
                <th>Doc Type</th>
                <th>Doc No.</th>
                <th>Doc Date</th>
                <th>Version No.</th>
                <th>Customer Code</th>
                <th>Project Name</th>
                <th>Customer Material Code</th>
                <th>RC Price</th>
                <th>NRC Price</th>
                <th>NRC Qty</th>
                <th>Currency</th>
                <th>Valid From Date</th>
                <th>Valid To Date</th>
                <th>Planned Submission Date</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="recordBody"></tbody>
          </table>
        </div>
        <div class="table-footer">
          <div>
            Showing <strong id="showing">1 to 10</strong> of
            <strong id="total">10</strong> records
          </div>
          <div class="page-size">
            10 <span>per page</span>
            <select>
              <option>10</option>
              <option>25</option>
              <option>50</option>
            </select>
          </div>
          <nav>
            <ul class="pagination pagination-sm mb-0">
              <li class="page-item disabled">
                <a class="page-link" href="#">‹</a>
              </li>
              <li class="page-item active">
                <a class="page-link" href="#">1</a>
              </li>
              <li class="page-item disabled">
                <a class="page-link" href="#">›</a>
              </li>
            </ul>
          </nav>
        </div>
      </section>
    </main>

