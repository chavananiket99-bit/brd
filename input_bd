      function escapeHTML(value) {
        return String(value ?? "").replace(
          /[&<>"']/g,
          (char) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            })[char],
        );
      }
      function normalizeStatus(status) {
        if (status === "Pending Program Review") return "Pending";
        if (status === "Completed" || status === "Approved") return "Complete";
        return status || "Pending";
      }
      function statusClass(status) {
        const normalized = normalizeStatus(status);
        if (normalized === "In Progress") return "progress";
        if (normalized === "Complete") return "completed";
        if (normalized === "Rejected") return "rejected";
        return "pending";
      }
      function render() {
        const d = (document.getElementById("docNo").value || "")
          .trim()
          .toLowerCase();
        const c = (document.getElementById("customer").value || "")
          .trim()
          .toLowerCase();
        const p = (document.getElementById("project").value || "")
          .trim()
          .toLowerCase();
        const m = (document.getElementById("material").value || "")
          .trim()
          .toLowerCase();
        const selectedStatus = document.getElementById("status").value;
        const rows = records
          .map((record, originalIndex) => ({ record, originalIndex }))
          .filter(
            ({ record: x }) =>
              (!d || x[1].toLowerCase().includes(d)) &&
              (!c || x[4].toLowerCase().includes(c)) &&
              (!p || x[5].toLowerCase().includes(p)) &&
              (!m || x[6].toLowerCase().includes(m)) &&
              (!selectedStatus || normalizeStatus(x[14]) === selectedStatus),
          );
        const body = document.getElementById("recordBody");
        body.innerHTML = rows
          .map(({ record: x, originalIndex }, i) => {
            const currentStatus = normalizeStatus(x[14]);
            const remark = x[15] || "";
            return `
<tr>
<td>${i + 1}</td>
<td>${escapeHTML(x[0])}</td>
<td class="doc-link">${escapeHTML(x[1])}</td>
<td>${escapeHTML(x[2])}</td>
<td>${escapeHTML(x[3])}</td>
<td class="customer-code">${escapeHTML(x[4])}</td>
<td class="project-name">${escapeHTML(x[5])}</td>
<td class="material-code">${escapeHTML(x[6])}</td>
<td>${escapeHTML(x[7])}</td>
<td>${escapeHTML(x[8])}</td>
<td>${escapeHTML(x[9])}</td>
<td>${escapeHTML(x[10])}</td>
<td>${escapeHTML(x[11])}</td>
<td>${escapeHTML(x[12])}</td>
<td>${escapeHTML(x[13])}</td>
<td>
<span
           class="status ${statusClass(currentStatus)}"
           title="${escapeHTML(remark || "No remarks added")}"
           aria-label="Status: ${escapeHTML(currentStatus)}. Remark: ${escapeHTML(remark || "No remarks added")}"
           tabindex="0"
>${escapeHTML(currentStatus)}</span>
</td>
<td>
<div class="action-group">
<button
             type="button"
             class="action"
             title="View record"
             onclick="viewRecord(${originalIndex})"
>
<i class="bi bi-eye"></i>
</button>
<button
             type="button"
             class="action edit-record-btn"
             title="Edit status and remarks"
             onclick="editRecord(${originalIndex})"
>
<i class="bi bi-pencil"></i>
</button>
<button
 type="button"
 class="action"
 title="View program progress"
 aria-label="View program progress"
 onclick="openProgressModal(${originalIndex})"
>
<i class="bi bi-three-dots"></i>
</button>
